# Databases, snapshots and exports hold prospect data: never commit them.
*.sqlite
*.sqlite-*
*.sql
!testdata/**
# The schema, which holds no data.
!migrations/**/*.sql
*.dump
*.csv
!testdata/**/*.csv
.env
.env.*

/prospector
/dist/
/bin/
node_modules/
.playwright-mcp/
/web/site-build/
# Written by the web build (npm run build in web/), which goreleaser and the Dockerfile run.
/assets/app/
/assets/js/
# Compiled from web/lang by the web build.
/web/src/lang/
# Written by npm run a11y in web/.
/web/a11y/.signed-in.json
/web/a11y/.reader.json
/web/test-results/
/web/playwright-report/
