package main

import (
	"fmt"
	"github.com/shutthegoatup/prospector/components/button"
	"net/url"
	"strconv"
	"time"
)

type TasksData struct {
	Rows   []TaskView
	Page   Page
	Closed bool
	// Open and All count every task, not only those on this page.
	Open, All int
	Now    time.Time
}

type TaskPage struct {
	TaskView
	Prompt string
	Now    time.Time
	// Agents are the organisation's own agents that are set up to run.
	Agents    []Agent
	AgentRuns []AgentRun
	// Each list the page shows a page of, and the address's query, which each one's
	// pager keeps the others' place in.
	NotesPage, EndedPage, WorkPage Page
	Query                          url.Values
}

func agentGoing(runs []AgentRun, agent int64) bool {
	for _, r := range runs {
		if r.AgentID == agent && r.Going() {
			return true
		}
	}
	return false
}

func agentRunText(r AgentRun) string {
	text := plural(r.Turns, "turn") + " · " + plural(r.ToolCalls, "tool call") + " · " + plural(r.Added, "thing") + " added"
	if r.Episodes > 1 {
		text += " · " + plural(r.Episodes, "fresh start")
	}
	if r.Resumes > 0 {
		text += " · carried on after " + plural(r.Resumes, "restart")
	}
	return text
}

func agentRunState(r AgentRun) string {
	switch {
	case r.Status == RunWaiting && r.WaitUntil != nil:
		return "Waiting for the model endpoint's limit, until " + r.WaitUntil.Format("2 Jan 15:04")
	case r.Going():
		return "Working, with " + r.Model
	}
	return r.Status + ": " + r.StopReason
}

func taskStatusLabel(status string) (string, string) {
	switch status {
	case TaskWorking:
		return "Being worked on", "agent"
	case TaskDone:
		return "Done", "ok"
	case TaskClosed:
		return "Closed", ""
	}
	return "Waiting for an agent", "warn"
}

func ago(t, now time.Time) string {
	d := now.Sub(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%d min ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return plural(int(d.Hours()), "hour") + " ago"
	}
	return t.Format("2 Jan 2006")
}

func taskLast(v TaskView, now time.Time) string {
	if v.Last == nil {
		return "No agent has picked this up yet"
	}
	did := "last change"
	if v.Last.Action == "task:pickup" {
		did = "picked it up"
	}
	return actorLabel(v.Last.User) + " · " + did + " " + ago(v.Last.At, now)
}

func heldText(r RequestView) string {
	if r.HeldBy == "" {
		return ""
	}
	return " · " + actorLabel(r.HeldBy) + " is on it until " + r.HeldUntil.Format("15:04")
}

func taskFound(companies, people int) string {
	return plural(companies, "company") + ", " + plural(people, "person")
}

func runText(r Run, now time.Time) string {
	span := r.Start.Format("2 Jan 15:04")
	if mins := int(r.End.Sub(r.Start).Minutes()); mins > 0 {
		span += fmt.Sprintf(", %d min", mins)
	}
	if r.Going(now) {
		span += " · last change " + ago(r.End, now)
	}
	if r.Changes == 0 {
		return span + " · picked up, nothing added yet"
	}
	return span + " · " + joinNonEmpty(", ", plural(r.Changes, "change")+" at "+plural(r.Companies, "company"),
		suggested(r.People), countOrNone(r.Drafts, "draft"))
}

func suggested(n int) string {
	if n == 0 {
		return ""
	}
	return plural(n, "person") + " suggested"
}

func countOrNone(n int, word string) string {
	if n == 0 {
		return ""
	}
	return plural(n, word)
}

func taskHref(q *Req, id int64) templ.SafeURL {
	return templ.SafeURL(q.Base() + "tasks/" + strconv.FormatInt(id, 10))
}

func companyHref(q *Req, id int64) templ.SafeURL {
	return templ.SafeURL(q.Base() + "companies/" + strconv.FormatInt(id, 10))
}

templ TaskStatus(status string) {
	{{ label, state := taskStatusLabel(status) }}
	@Pill(label, state)
}

templ TasksView(q *Req, d TasksData) {
	@PageHead("Tasks")
	<p class="mb-5 max-w-[70ch] text-sm text-muted-foreground">Write what you want found. An agent picks it up, and what it finds waits in Research for you. Anyone can ask for more later, and a different agent can carry on from what is already here.</p>
	<div class="flex flex-wrap items-start gap-8">
		<div class="flex min-w-0 flex-[999_1_480px] flex-col gap-3">
			<div class="flex flex-wrap gap-2">
				@Chip(q.Base()+"tasks", "Open", d.Open, !d.Closed)
				@Chip(q.Base()+"tasks?closed=1", "With closed", d.All, d.Closed)
			</div>
			if len(d.Rows) == 0 {
				@Empty("No tasks yet", "Write a brief and hand it to your agent with the prompt on its page.")
			}
			for _, t := range d.Rows {
				<article class="flex flex-col gap-2.5 rounded-xl border border-border bg-card p-3.5 text-sm">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<a href={ taskHref(q, t.ID) } class="font-medium underline">{ t.Title }</a>
						@TaskStatus(t.Status)
					</div>
					if open := t.Open(); len(open) > 0 {
						<p class="text-muted-foreground">{ firstLine(open[len(open)-1].Text) }</p>
					}
					<div class="flex flex-wrap items-center justify-between gap-2">
						@Meta(taskLast(t, d.Now))
						@Meta(taskFound(len(t.Companies), len(t.People)))
					</div>
				</article>
			}
			@Pager(d.Page, func(n int) string { return pageLink(q.Base()+"tasks", n, "closed", taskClosedParam(d.Closed)) })
		</div>
		<aside class="flex min-w-0 flex-[1_1_280px] flex-col gap-3 panel p-5 text-sm">
			<form data-form="api/v1/tasks" data-go="tasks/{id}" class="flex flex-col gap-4">
				<label class="flex flex-col gap-1.5">
					@Label("What should be found?")
					<textarea name="brief" rows="7" required maxlength="4000" placeholder="Heads of procurement at UK kitchen makers with their own showrooms. About twenty, with the page that shows each one's role." class="rounded-lg border border-input bg-muted px-3 py-2 text-sm leading-relaxed"></textarea>
				</label>
				<label class="flex flex-col gap-1.5">
					@Label("Short name (optional)")
					<input name="title" maxlength="60" class="h-10 rounded-lg border border-input bg-muted px-3 text-sm"/>
				</label>
				<div class="flex flex-wrap items-center gap-3">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Create task
					}
					<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
				</div>
			</form>
			<p class="text-muted-foreground">Agents can read the brief and everyone's requests. Don't put anything in them you wouldn't put in a note to a colleague.</p>
		</aside>
	</div>
}

templ TaskDetailView(q *Req, d TaskPage) {
	@PageHead(d.Title) {
		@TaskStatus(d.Status)
	}
	<div class="flex flex-wrap items-start gap-8">
		<div class="flex min-w-0 flex-[999_1_480px] flex-col gap-5">
			@Section("Asked", taskLast(d.TaskView, d.Now)) {
				for i, r := range d.Requests {
					<div class="flex flex-col gap-2 border-b border-dashed border-border py-2.5 text-sm last:border-0">
						@Quote(r.Text)
						<div class="flex flex-wrap items-center justify-between gap-2">
							if r.DoneAt != nil {
								@Meta(r.AskedBy + " · " + r.AskedAt.Format("2 Jan 15:04") + " · done, says " + actorLabel(r.DoneBy))
							} else if i == 0 {
								@Meta(r.AskedBy + " · " + r.AskedAt.Format("2 Jan 15:04") + " · found so far: " + taskFound(r.Companies, r.People) + heldText(r))
							} else {
								@Meta(r.AskedBy + " · " + r.AskedAt.Format("2 Jan 15:04") + " · added since: " + taskFound(r.Companies, r.People) + heldText(r))
							}
							if d.ClosedAt == nil {
								if r.DoneAt != nil {
									@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/task-requests/" + strconv.FormatInt(r.ID, 10), "data-method": "PATCH", "data-body": jsonBody("done", false)}}) {
										Reopen
									}
								} else {
									@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/task-requests/" + strconv.FormatInt(r.ID, 10), "data-method": "PATCH", "data-body": jsonBody("done", true)}}) {
										Mark done
									}
								}
							}
						</div>
					</div>
				}
				if d.ClosedAt == nil {
					<form data-form={ "api/v1/tasks/" + strconv.FormatInt(d.ID, 10) + "/requests" } data-reset="true" data-refresh="true" class="flex flex-col gap-3">
						<label class="flex flex-col gap-1.5">
							@Label("Ask for more")
							<textarea name="text" rows="3" required maxlength="2000" placeholder="Find twenty more, in Scotland this time." class="rounded-lg border border-input bg-muted px-3 py-2 text-sm leading-relaxed"></textarea>
						</label>
						<div class="flex flex-wrap items-center gap-3">
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								Ask
							}
							<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
						</div>
					</form>
				}
			}
			@Section("Found", "What agents added for this task, or matched to it. Companies and people wait in Research until someone qualifies or picks them.") {
				if len(d.Companies) == 0 && len(d.People) == 0 {
					<p class="text-sm text-muted-foreground">Nothing yet.</p>
				}
				for _, c := range d.Companies {
					<div class="flex flex-wrap justify-between gap-2 border-b border-dashed border-border py-2.5 text-sm">
						<a href={ companyHref(q, c.ID) } class="font-medium underline">{ c.Name }</a>
						<span class="font-mono text-xs text-muted-foreground">{ c.Stage }</span>
					</div>
				}
				for _, p := range d.People {
					<div class="flex flex-wrap justify-between gap-2 border-b border-dashed border-border py-2.5 text-sm">
						<span><b>{ p.Name }</b> <span class="text-muted-foreground">{ prefixed("· ", joinNonEmpty(", ", p.Title, p.Company)) }</span></span>
						<span class="font-mono text-xs text-muted-foreground">{ p.Stage }</span>
					</div>
				}
			}
			@Section("Agents' notes", "What they skipped or couldn't find, in their words. Not checked by anyone.") {
				@Notes(q, d.Notes)
				@Pager(d.NotesPage, func(n int) string { return pageHref(string(taskHref(q, d.ID)), d.Query, "notes", n) })
			}
		</div>
		<aside class="flex min-w-0 flex-[1_1_280px] flex-col gap-5">
			if len(d.Agents) > 0 || len(d.AgentRuns) > 0 {
				@Section("Prospector's agents", "Work the task here, each with the model and tools set in Settings, each on its own request. What they find waits in Research.") {
					for _, run := range d.AgentRuns {
						if run.Going() {
							<div class="flex flex-col gap-1.5 border-b border-dashed border-border py-2 text-sm">
								<span><b>{ run.AgentName }</b> · { agentRunState(run) }</span>
								@Meta(agentRunText(run))
								<div>
									@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/runs/" + strconv.FormatInt(run.ID, 10) + "/stop"}}) {
										{ "Stop " + run.AgentName }
									}
								</div>
							</div>
						}
					}
					if d.ClosedAt == nil {
						<div class="flex flex-wrap gap-2">
							for _, agent := range d.Agents {
								if !agentGoing(d.AgentRuns, agent.ID) {
									@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-post": "api/v1/tasks/" + strconv.FormatInt(d.ID, 10) + "/runs", "data-body": jsonBody("agent", agent.ID)}}) {
										{ "Run " + agent.Name }
									}
								}
							}
						</div>
					}
					for _, r := range d.AgentRuns {
						if !r.Going() {
							<div class="border-b border-dashed border-border py-2 text-sm last:border-0">
								<span class="block"><b>{ r.AgentName }</b> · { agentRunState(r) }</span>
								@Meta(r.StartedBy + " · " + r.StartedAt.Format("2 Jan 15:04") + " · " + agentRunText(r))
							</div>
						}
					}
					@Pager(d.EndedPage, func(n int) string { return pageHref(string(taskHref(q, d.ID)), d.Query, "runs", n) })
				}
			}
			if d.ClosedAt == nil {
				@Section("Hand it to your agent", "Paste this into an agent connected to this organisation. Clients that show prompts as commands also have it as work_task.") {
					@Quote(d.Prompt)
					<div>
						@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-copy": d.Prompt}}) {
							Copy prompt
						}
					</div>
				}
			}
			@Section("Work so far", "Each stretch of an agent's changes. An agent that is only reading doesn't show.") {
				if len(d.Runs) == 0 {
					<p class="text-sm text-muted-foreground">None yet.</p>
				}
				for _, r := range d.Runs {
					<div class="border-b border-dashed border-border py-2 text-sm last:border-0">
						<b class="font-mono text-[13px] text-mark">{ actorLabel(r.Actor) }</b>
						<span class="block text-muted-foreground">{ runText(r, d.Now) }</span>
					</div>
				}
				@Pager(d.WorkPage, func(n int) string { return pageHref(string(taskHref(q, d.ID)), d.Query, "work", n) })
			}
			<div>
				if d.ClosedAt == nil {
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/tasks/" + strconv.FormatInt(d.ID, 10), "data-method": "PATCH", "data-body": jsonBody("closed", true), "data-confirm": "Close this task? Agents stop seeing it; what was found stays."}}) {
						Close task
					}
				} else {
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/tasks/" + strconv.FormatInt(d.ID, 10), "data-method": "PATCH", "data-body": jsonBody("closed", false)}}) {
						Reopen task
					}
				}
			</div>
		</aside>
	</div>
}

templ Notes(q *Req, notes []NoteView) {
	if len(notes) == 0 {
		<p class="text-sm text-muted-foreground">None.</p>
	}
	for _, n := range notes {
		<div class="flex flex-col gap-1.5 border-b border-dashed border-border py-2.5 text-sm last:border-0">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<span class="flex flex-wrap items-center gap-2">
					@Pill(noteKindLabel(n.Kind), "agent")
					if n.Company != "" {
						<a href={ companyHref(q, n.CompanyID) } class="font-mono text-xs text-mark underline">{ n.Company }</a>
					}
				</span>
				@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "ui/note/delete", "data-body": jsonBody("id", n.ID), "data-confirm": "Delete this note?"}}) {
					Delete
				}
			</div>
			<p class="whitespace-pre-wrap">{ n.Text }</p>
			@Meta(actorLabel(n.Actor) + " · " + n.CreatedAt.Format("2 Jan 15:04"))
		</div>
	}
}
