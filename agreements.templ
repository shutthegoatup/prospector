package main

import (
	"github.com/shutthegoatup/prospector/components/button"
	"strconv"
)

func agreementFileLine(a Agreement) string {
	if a.FileHash == "" {
		return "No document yet"
	}
	return a.FileName + " · " + strconv.FormatInt((a.FileSize+1023)/1024, 10) + " KB · SHA-256 " + a.FileHash[:12] + "…"
}

// AgreementsBlock is a company's agreements on its page: each draft with its document,
// and a form to start one. Signing comes later.
templ AgreementsBlock(q *Req, company int64, list []Agreement) {
	<div>
		@Label("Agreements")
		if len(list) == 0 {
			<p class="py-2 text-sm text-muted-foreground">None yet. Start one, then upload the contract as a PDF.</p>
		}
		for _, a := range list {
			<div class="mt-1 flex flex-col gap-2 rounded-lg border border-border p-3 text-sm" data-agreement={ strconv.FormatInt(a.ID, 10) }>
				<div class="flex flex-wrap items-center justify-between gap-2">
					<b>{ a.Name }</b>
					<span class="font-mono text-xs text-muted-foreground">{ "draft · by " + actorLabel(a.CreatedBy) }</span>
				</div>
				@Meta(agreementFileLine(a))
				<div class="flex flex-wrap items-center gap-2">
					if a.FileHash != "" {
						<a href={ templ.SafeURL(q.Base() + "api/v1/agreements/" + strconv.FormatInt(a.ID, 10) + "/document") } class="font-mono text-xs text-mark underline">Download</a>
					}
					<label class="font-mono text-xs text-muted-foreground">
						if a.FileHash == "" {
							Upload the PDF
						} else {
							Replace the PDF
						}
						<input type="file" accept="application/pdf,.pdf" class="text-xs" data-upload={ strconv.FormatInt(a.ID, 10) }/>
					</label>
					@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/agreements/" + strconv.FormatInt(a.ID, 10), "data-method": "DELETE", "data-confirm": "Remove the draft " + a.Name + " and its document?"}}) {
						Remove
					}
				</div>
			</div>
		}
		<details class="mt-2 text-sm">
			<summary class="cursor-pointer font-mono text-xs text-muted-foreground">Start an agreement</summary>
			<form data-form="api/v1/agreements" data-refresh="true" data-reset="true" class="mt-2 flex flex-wrap items-center gap-2">
				<input type="number" name="company" value={ strconv.FormatInt(company, 10) } hidden/>
				<input name="name" required maxlength="120" placeholder="e.g. Annual service agreement 2027" aria-label="Name of the agreement" class="h-9 min-w-[220px] flex-1 rounded-lg border border-input bg-muted px-3 text-sm"/>
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
					Start
				}
				<span data-result class="font-mono text-xs text-muted-foreground"></span>
			</form>
			@Meta("Prospector keeps the PDF as uploaded, with its SHA-256, and doesn't read what it says. It is not for deeds, or anything that must be witnessed or notarised. Sending it for signature comes later.")
		</details>
	</div>
}
