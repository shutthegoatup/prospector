package main

import (
	"github.com/shutthegoatup/prospector/components/button"
	"strconv"
)

func recipientPath(a Agreement, r Party) string {
	return "api/v1/agreements/" + strconv.FormatInt(a.ID, 10) + "/recipients/" + strconv.FormatInt(r.ID, 10)
}

func partyLine(r Party) string {
	if r.UserID != nil {
		return r.Email + " · member"
	}
	return r.Email
}

// PrepareView sets out a draft for signing: its signers in order, those who get a copy,
// and its pages, where the page script places each signer's fields.
templ PrepareView(q *Req, p PreparePage) {
	{{ edit := canDo(ctx, areaSales) && p.Agreement.Status == AgreementDraft }}
	{{ id := strconv.FormatInt(p.Agreement.ID, 10) }}
	<a href={ templ.SafeURL(q.Base() + "companies/" + strconv.FormatInt(p.Company.ID, 10)) } class="font-mono text-xs text-mark">← { p.Company.Name }</a>
	@PageHead("Prepare for signing") {
		@Meta(p.Agreement.Name + " · " + p.Agreement.FileName + " · " + strconv.Itoa(p.Agreement.PageCount) + " pages")
	}
	if p.Problem != "" {
		<p class="mb-4 text-sm text-[var(--stop)]" role="alert">{ p.Problem }</p>
	}
	<div class="flex flex-wrap items-start gap-5">
		<div class="flex max-w-full flex-[1_1_240px] flex-col gap-4 md:max-w-[260px]">
			<section class="flex flex-col gap-2 panel p-3.5">
				@Label("Signers")
				if len(p.signers()) == 0 {
					@Meta("Nobody yet.")
				}
				for i, r := range p.signers() {
					<div class="flex flex-col gap-1.5 rounded-lg border border-border p-2 text-sm">
						<label class="flex items-center gap-2">
							if edit {
								<input type="radio" name="placing" value={ strconv.FormatInt(r.ID, 10) } checked?={ i == 0 }/>
							}
							<span class="shrink-0 rounded-sm" style={ "width:10px;height:10px;background:" + signerColour(i) } data-signer={ strconv.FormatInt(r.ID, 10) } data-colour={ signerColour(i) } data-name={ r.Name }></span>
							<b>{ strconv.Itoa(i+1) + " · " + r.Name }</b>
						</label>
						@Meta(partyLine(r))
						if edit {
							<div class="flex flex-wrap gap-1.5">
								if i > 0 {
									@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": recipientPath(p.Agreement, r), "data-method": "PATCH", "data-body": `{"position":` + strconv.Itoa(p.signers()[max(i-1, 0)].Position) + `}`, "aria-label": "Move " + r.Name + " up"}}) {
										↑
									}
								}
								@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": recipientPath(p.Agreement, r), "data-method": "PATCH", "data-body": `{"role":"copy"}`}}) {
									Copy only
								}
								@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": recipientPath(p.Agreement, r), "data-method": "DELETE", "data-confirm": "Take " + r.Name + " off, with their fields?"}}) {
									Remove
								}
							</div>
						}
					</div>
				}
				if edit {
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" data-in-order={ id } checked?={ p.Agreement.InOrder }/>
						Sign in this order
					</label>
				} else {
					@Meta(map[bool]string{true: "They sign in this order.", false: "They can sign in any order."}[p.Agreement.InOrder])
				}
			</section>
			<section class="flex flex-col gap-2 panel p-3.5">
				@Label("Gets a copy")
				if len(p.copies()) == 0 {
					@Meta("Nobody. Everyone who signs gets one anyway.")
				}
				for _, r := range p.copies() {
					<div class="flex flex-wrap items-center justify-between gap-2 text-sm">
						<span>{ r.Name } <span class="font-mono text-xs text-muted-foreground">{ partyLine(r) }</span></span>
						if edit {
							<span class="flex gap-1.5">
								@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": recipientPath(p.Agreement, r), "data-method": "PATCH", "data-body": `{"role":"signer"}`}}) {
									Signs
								}
								@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": recipientPath(p.Agreement, r), "data-method": "DELETE"}}) {
									Remove
								}
							</span>
						}
					</div>
				}
			</section>
			if edit {
				<section class="flex flex-col gap-2 panel p-3.5">
					@Label("Add someone")
					<form data-form={ "api/v1/agreements/" + id + "/recipients" } data-refresh="true" class="flex flex-col gap-2">
						<select name="contact" data-number="true" required aria-label={ "A person at " + p.Company.Name } class="h-9 rounded-lg border border-input bg-muted px-2 text-sm">
							<option value="">{ "Someone at " + p.Company.Name }</option>
							for _, c := range p.People {
								if !p.on(c.ID, 0) {
									<option value={ strconv.FormatInt(c.ID, 10) }>{ personLine(c) }</option>
								}
							}
						</select>
						@roleAndAdd()
					</form>
					<form data-form={ "api/v1/agreements/" + id + "/recipients" } data-refresh="true" class="flex flex-col gap-2">
						<select name="member" data-number="true" required aria-label="A member" class="h-9 rounded-lg border border-input bg-muted px-2 text-sm">
							<option value="">{ "Someone at " + q.Org.Name }</option>
							for _, m := range p.Members {
								if !p.on(0, m.UserID) {
									<option value={ strconv.FormatInt(m.UserID, 10) }>{ m.Name + " · " + m.Email }</option>
								}
							}
						</select>
						@roleAndAdd()
					</form>
					@Meta("People need one email address and can't be on the never-contact list. Nobody is emailed yet.")
				</section>
			}
			<section class="flex flex-col gap-1.5 panel p-3.5">
				@Label("Before it can be sent")
				<div data-missing class="flex flex-col gap-1.5">
					if len(p.Missing) == 0 {
						<p class="font-mono text-xs text-[var(--ok)]">✓ Every signer has a signature field.</p>
					}
					for _, m := range p.Missing {
						@Meta("· " + m)
					}
				</div>
				@Meta("Sending it for signature comes in the next release. Until then nothing here leaves Prospector.")
			</section>
		</div>
		<div class="flex min-w-0 flex-[999_1_560px] flex-col gap-3" data-editor={ id } data-pages={ strconv.Itoa(p.Agreement.PageCount) } data-hash={ p.Agreement.FileHash } data-edit?={ edit } data-no-refresh="true">
			if edit && len(p.signers()) > 0 {
				<div class="flex flex-wrap items-center gap-2" data-palette>
					<span class="font-mono text-xs text-muted-foreground">Place for the signer picked:</span>
					for _, k := range []struct{ Kind, Label string }{{"signature", "Signature"}, {"initials", "Initials"}, {"name", "Name"}, {"date", "Date signed"}, {"text", "Text"}, {"tick", "Tick box"}} {
						@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-kind": k.Kind, "draggable": "true"}}) {
							{ k.Label }
						}
					}
					<span data-saved class="font-mono text-xs text-muted-foreground"></span>
				</div>
				@Meta("Drag one onto a page, or click it to put it on the page in view. Drag a field to move it, its corner to size it.")
			} else if edit {
				@Meta("Add someone to sign it, then place their fields on the pages.")
			}
			<div data-pages-here class="flex flex-col items-center gap-6">
				@Meta("The pages appear here.")
			</div>
		</div>
	</div>
	<script type="module" src={ "/assets/js/prepare.js?v=" + assetVersion }></script>
}

templ roleAndAdd() {
	<div class="flex items-center gap-2">
		<select name="role" aria-label="What they do" class="h-9 rounded-lg border border-input bg-muted px-2 text-sm">
			<option value="signer">signs</option>
			<option value="copy">gets a copy</option>
		</select>
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
			Add
		}
		<span data-result class="font-mono text-xs text-muted-foreground"></span>
	</div>
}
