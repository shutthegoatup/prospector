package main

import (
	"fmt"
	"github.com/shutthegoatup/prospector/components/button"
	"github.com/shutthegoatup/prospector/components/card"
	"github.com/shutthegoatup/prospector/components/input"
	"github.com/shutthegoatup/prospector/components/nativeselect"
	"github.com/shutthegoatup/prospector/components/textarea"
	"strconv"
)

func stepLabel(key string) string {
	for _, s := range Steps {
		if s.Key == key {
			return s.Card
		}
	}
	return key
}

templ TodayView(q *Req, d TodayData) {
	@PageHead("Today") {
		<span class="font-mono text-xs text-muted-foreground">{ d.Now }</span>
	}
	<div class="flex flex-wrap items-start gap-8">
		<section class="flex min-w-0 flex-[999_1_560px] flex-col gap-4">
			<p class="text-sm text-muted-foreground">
				<span class="tag mr-1.5 text-sm">{ strconv.Itoa(d.Total) }</span>
				things due, best first: next steps, calls where it's office hours, messages, emails, follow-ups, then LinkedIn adds.
			</p>
			<nav class="flex flex-wrap gap-2" aria-label="Filter by step">
				@Chip(q.Base()+"today", "All", d.Total, d.Filter == "")
				for _, s := range Steps {
					if d.Counts[s.Key] > 0 || d.Filter == s.Key {
						@Chip(q.Base()+"today?step="+s.Key, s.Label, d.Counts[s.Key], d.Filter == s.Key)
					}
				}
			</nav>
			if d.Filter == "linkedin" {
				<p class="font-mono text-xs text-muted-foreground">Keys: <kbd class="text-foreground">o</kbd> open profile and copy the note · <kbd class="text-foreground">a</kbd> added · <kbd class="text-foreground">s</kbd> skip</p>
			}
			if len(d.Cards) == 0 {
				@Empty("Nothing due here", "Add someone from LinkedIn, or check Research for companies waiting on you.")
			}
			for i, c := range d.Cards {
				@Item(q, c, i)
			}
			if d.Shown > len(d.Cards) {
				@Meta(fmt.Sprintf("Showing the first %d of %d. Clear some, or filter by step above.", len(d.Cards), d.Shown))
			}
		</section>
		<aside class="flex min-w-0 flex-[1_1_260px] flex-col gap-4">
			<div class="flex flex-col gap-1 panel p-5">
				@Label("Do now")
				{{ todo := doNow(q, d) }}
				if len(todo) == 0 {
					<p class="pt-1.5 text-sm text-muted-foreground">Nothing due right now.</p>
				}
				for _, t := range todo {
					<a href={ templ.SafeURL(t.Href) } class="group flex items-baseline justify-between gap-3 border-b border-dashed border-border py-2 text-sm text-foreground last:border-0 hover:text-mark">
						<span>{ t.Label }</span>
						<span class="flex items-baseline gap-2"><span class="font-mono text-lg text-mark">{ strconv.Itoa(t.Count) }</span><span class="text-muted-foreground group-hover:text-mark">→</span></span>
					</a>
				}
			</div>
			if d.LaterCall > 0 {
				<div class="flex flex-col gap-2.5 panel p-5">
					@Label("Later")
					<p class="text-sm text-muted-foreground">{ plural(d.LaterCall, "call") } outside office hours right now</p>
				</div>
			}
			<div class="flex flex-col gap-3 panel p-5">
				@Label("Last 7 days")
				<div class="grid grid-cols-2 gap-3">
					@Stat(d.Week.Touches, "touches")
					@Stat(d.Week.Replies, "replies")
					@Stat(d.Week.Meetings, "meetings")
					@Stat(d.Week.Researched, "researched")
				</div>
			</div>
		</aside>
	</div>
}

templ Stat(n int64, label string) {
	<div><div class="font-mono text-2xl">{ strconv.FormatInt(n, 10) }</div>@Meta(label)</div>
}

func id(c Card) string { return strconv.FormatInt(c.ID, 10) }

templ Mark(c Card, step, text string, primary bool) {
	@button.Button(button.Props{Size: button.SizeSm, Variant: markVariant(primary),
		Attributes: templ.Attributes{"data-mark": step, "data-id": id(c), "data-next": strconv.FormatInt(c.Next, 10), "data-key": markKey(c.Step, step)}}) {
		{ text }
	}
}

func markKey(cardStep, step string) string {
	if cardStep != "linkedin" {
		return ""
	}
	switch step {
	case "linkedin":
		return "a"
	case "hold":
		return "s"
	}
	return ""
}

func markVariant(primary bool) button.Variant {
	if primary {
		return button.VariantDefault
	}
	return button.VariantOutline
}

templ CopyButton(text, copy, open, key string) {
	@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-copy": copy, "data-open": open, "data-key": key}}) {
		{ text }
	}
}

templ Field(id, name, text, value string, multi bool) {
	@Label(text)
	if multi {
		@textarea.Textarea(textarea.Props{Value: value, Placeholder: text, Rows: 3, Class: "bg-muted",
			Attributes: templ.Attributes{"data-field": name, "data-id": id}})
	} else {
		@input.Input(input.Props{Value: value, Placeholder: "—", Class: "h-8 bg-muted",
			Attributes: templ.Attributes{"data-field": name, "data-id": id}})
	}
}

func itemStyle(i int) string { return fmt.Sprintf("--i:%d", i) }

func itemClass(held bool) string {
	if held {
		return "opacity-45 grayscale hover:opacity-80 transition-opacity"
	}
	return ""
}

templ Item(q *Req, c Card, i int) {
	@card.Card(card.Props{Class: "rail rise gap-0 py-0 " + itemClass(c.Held),
		Attributes: templ.Attributes{"data-card": id(c), "data-state": c.State, "style": itemStyle(i)}}) {
		<div class="flex flex-col gap-4 px-5 py-5 sm:px-6">
			<div class="flex items-start justify-between gap-4">
				<div class="min-w-0">
					<div class="font-mono text-[11px] font-medium uppercase tracking-wider">
						<span class="tag">{ stepLabel(c.Step) }</span>
						if c.DraftBy != "" {
							<span class="text-muted-foreground">· drafted by { actorLabel(c.DraftBy) }</span>
						}
					</div>
					<h2 class="mt-2 font-heading text-2xl font-bold leading-tight tracking-tight">{ c.Name }</h2>
					<p class="mt-0.5 truncate text-sm text-muted-foreground">
						if c.CompanyID != nil {
							<a class="text-foreground/90 hover:text-mark" href={ templ.SafeURL(q.Base() + "companies/" + strconv.FormatInt(*c.CompanyID, 10)) }>{ deref(c.Maker) }</a>
						} else {
							<span class="text-foreground/90">{ deref(c.Maker) }</span>
						}
						if c.Title != "" {
							<span class="mx-1.5 text-border">/</span>{ c.Title }
						}
					</p>
				</div>
				if deref(c.Fit) != "" {
					<span class="shrink-0 rounded-md border-2 border-foreground bg-primary px-2 py-0.5 font-mono text-xs font-medium text-primary-foreground" title="Fit">{ deref(c.Fit) }</span>
				}
			</div>
			if len(c.People) > 1 {
				<label class="flex items-center gap-3">
					@Label("Send to")
					@nativeselect.NativeSelect(nativeselect.Props{Size: nativeselect.SizeSm, Class: "flex-1",
						Attributes: templ.Attributes{"data-field": "send_to", "data-id": id(c), "data-refresh": "true"}}) {
						for _, p := range c.People {
							@nativeselect.Option(nativeselect.OptionProps{Value: p.Name, Selected: p.Name == c.Name}) {
								{ p.Name }
								if p.Title != "" {
									{ " · " + p.Title }
								}
							}
						}
					}
				</label>
			}
			if c.Step != "next" {
				<div class="flex flex-wrap gap-1.5">
					for _, b := range c.Badges {
						@Pill(b.Text, b.State)
					}
				</div>
			}
			@StepBody(c)
		</div>
		<details class="group border-t border-border/70 bg-muted">
			<summary class="flex cursor-pointer list-none items-center gap-2 px-5 py-2.5 font-mono text-xs text-muted-foreground hover:text-foreground sm:px-6">
				<span class="transition-transform group-open:rotate-90">›</span>
				{ "Details · " + plural(len(c.SourceList), "source") }
				if deref(c.Flags) != "" {
					· flags
				}
			</summary>
			<div class="flex flex-col gap-4 px-5 pb-5 sm:px-6">
				<div class="grid grid-cols-[5.5rem_1fr] items-center gap-x-3 gap-y-2 text-sm">
					@Field(id(c), "email", "Email", deref(c.Email), false)
					@Field(id(c), "phone", "Phone", deref(c.Phone), false)
					@Field(id(c), "linkedin", "LinkedIn", deref(c.Linkedin), false)
					@Field(id(c), "tz", "Time zone", deref(c.Tz), false)
				</div>
				if len(c.SourceList) > 0 {
					<div>
						@Label("Sources to check before sending")
						<ol class="mt-1.5 flex list-decimal flex-col gap-1 pl-5 text-sm marker:font-mono marker:text-xs marker:text-muted-foreground">
							for _, u := range c.SourceList {
								<li><a class="break-all text-mark underline-offset-4 hover:text-mark hover:underline" href={ safeHref(u) } target="_blank" rel="noopener">{ u }</a></li>
							}
						</ol>
					</div>
				}
				if deref(c.Flags) != "" {
					<div>
						@Label("Flags")
						<div class="mt-1.5 whitespace-pre-wrap text-sm text-muted-foreground">{ deref(c.Flags) }</div>
					</div>
				}
			</div>
		</details>
	}
}

templ Actions() {
	<div class="flex flex-wrap items-center gap-2">
		{ children... }
	</div>
}

templ StepBody(c Card) {
	switch c.Step {
		case "call":
			<div>
				<a class="font-mono text-2xl font-medium tracking-tight text-foreground underline decoration-primary decoration-4 underline-offset-4 hover:decoration-coral" href={ templ.SafeURL("tel:" + c.Tel) }>{ c.Number }</a>
				if c.About != "" {
					<p class="text-sm text-muted-foreground">{ c.About }</p>
				}
				<div class="mt-1">
					@Meta(callMeta(c))
				</div>
			</div>
			<details class="rounded-lg border-l-2 border-primary bg-muted px-4 py-3">
				<summary class="cursor-pointer font-mono text-xs uppercase tracking-wider text-muted-foreground">Call script</summary>
				for _, l := range c.Script {
					<div class="mt-3">
						<div class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{ l.Cue }</div>
						<p class="mt-0.5">{ l.Say }</p>
					</div>
				}
			</details>
			<div class="grid grid-cols-[5.5rem_1fr] items-start gap-3 text-sm">
				@Field(id(c), "call_notes", "Notes", deref(c.CallNotes), true)
			</div>
			@Actions() {
				@Mark(c, "call", "Called", true)
				@Mark(c, "replied", "Interested", false)
				@Mark(c, "declined", "Not interested", false)
			}
		case "linkedin":
			@textarea.Textarea(textarea.Props{ID: "note-" + id(c), Value: c.Text, Rows: 5, Class: "bg-muted text-[15px] leading-relaxed",
				Attributes: templ.Attributes{"data-field": "note", "data-id": id(c)}})
			@Actions() {
				@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-copy-from": "note-" + id(c), "data-open": string(safeHref(deref(c.Linkedin))), "data-key": "o"}}) {
					Open + copy
				}
				@Mark(c, "linkedin", "Added", false)
				@Mark(c, "hold", "Skip", false)
				<span class="ml-auto">
					@Meta(fmt.Sprintf("%d / 300 chars", len([]rune(c.Text))))
				</span>
			}
		case "accepted":
			@Meta(acceptedMeta(c))
			@textarea.Textarea(textarea.Props{ID: "message-" + id(c), Value: c.Text, Rows: 10, Class: "bg-muted text-[15px] leading-relaxed",
				Attributes: templ.Attributes{"data-field": "message", "data-id": id(c)}})
			@Actions() {
				@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-copy-from": "message-" + id(c), "data-open": string(safeHref(deref(c.Linkedin)))}}) {
					Open + copy
				}
				@Mark(c, "email", "Sent", false)
				@Mark(c, "replied", "Replied", false)
			}
		case "next":
			@Meta(nextMeta(c.Contact))
			<div class="grid grid-cols-[5.5rem_1fr] items-center gap-x-3 gap-y-2 text-sm">
				@Field(id(c), "next_step", "Next step", c.NextStep, false)
				@Label("By")
				@input.Input(input.Props{Type: "date", Value: deref(c.NextDate), Class: "h-8 w-44 bg-muted",
					Attributes: templ.Attributes{"data-field": "next_date", "data-id": id(c)}})
			</div>
			@Actions() {
				@StageSelect(c.Contact)
			}
		default:
			@Meta(emailMeta(c))
			@Quote(c.Text)
			@Actions() {
				@CopyButton("Copy", c.Copy, "", "")
				@Mark(c, c.Step, "Sent", false)
				@Mark(c, "replied", "Replied", false)
				if c.Step == "email" {
					@Mark(c, "accepted", "Accepted instead", false)
				}
			}
	}
}

templ StageSelect(c Contact) {
	<label class="flex items-center gap-2">
		@Label("Stage")
		@nativeselect.NativeSelect(nativeselect.Props{Size: nativeselect.SizeSm,
			Attributes: templ.Attributes{"data-field": "stage", "data-id": strconv.FormatInt(c.ID, 10), "data-refresh": "true"}}) {
			for _, s := range Stages {
				@nativeselect.Option(nativeselect.OptionProps{Value: s.Key, Selected: s.Key == c.Stage || (c.Stage == "" && s.Key == "replied")}) {
					{ s.Label }
				}
			}
		}
	</label>
}

func nextMeta(c Contact) string {
	st := c.Stage
	if st == "" {
		st = "replied"
	}
	s := "In conversation · " + st + " · replied " + deref(c.Replied)
	if c.NextStep == "" {
		return s + " · no next step yet"
	}
	return s + " · due " + deref(c.NextDate)
}

func callMeta(c Card) string {
	s := "Not on LinkedIn yet"
	if c.LinkedinAdded != nil {
		s = "Added on LinkedIn " + *c.LinkedinAdded + markedBy(c, "linkedin")
	}
	if c.EmailSent != nil {
		s += " · emailed " + *c.EmailSent + markedBy(c, "email")
	}
	return s
}

func markedBy(c Card, step string) string {
	if a := c.AgentMarks[step]; a != "" {
		return " (" + actorLabel(a) + ")"
	}
	return ""
}

func acceptedMeta(c Card) string {
	s := "Accepted " + deref(c.Accepted) + markedBy(c, "accepted") + " · LinkedIn message"
	if deref(c.Message) == "" {
		s += " (none written yet, so this is the email; edit it down)"
	}
	return s
}

func emailMeta(c Card) string {
	s := "added " + deref(c.LinkedinAdded) + markedBy(c, "linkedin")
	if c.Step == "email" {
		s = "Subject: " + deref(c.Subject) + " · " + s
	}
	return s
}

type Todo struct {
	Label, Href string
	Count       int
}

// doNow is the side panel's list of what to do next, in Today's order.
func doNow(q *Req, d TodayData) []Todo {
	var out []Todo
	add := func(label, href string, n int) {
		if n > 0 {
			out = append(out, Todo{label, q.Base() + href, n})
		}
	}
	add("Set next steps", "today?step=next", d.Counts["next"])
	add("Make calls now", "today?step=call", d.Counts["call"]-d.LaterCall)
	add("Send LinkedIn messages", "today?step=accepted", d.Counts["accepted"])
	add("Send emails", "today?step=email", d.Counts["email"])
	add("Send follow-ups", "today?step=followup", d.Counts["followup"])
	add("Add on LinkedIn", "today?step=linkedin", d.Counts["linkedin"])
	add("Review researched companies", "research", d.Review)
	return out
}
