package main

import (
	"github.com/shutthegoatup/prospector/components/button"
	"strconv"
	"strings"
)

func researchEmpty(f string) (string, string) {
	switch f {
	case "review":
		return "Nothing to review", "Companies your agents and discovery jobs add will wait here."
	case "contact":
		return "Every qualified company has a contact", "Add someone with + Add person, or let an agent suggest people."
	case "verify":
		return "No emails to verify", "Contacts whose email is a pattern guess show up here."
	case "details":
		return "No details to check", "An email, phone or profile an agent finds for someone already here waits for you to accept it."
	}
	return "Nothing here", ""
}

func jsonBody(pairs ...any) string {
	s := "{"
	for i := 0; i < len(pairs); i += 2 {
		if i > 0 {
			s += ","
		}
		s += strconv.Quote(pairs[i].(string)) + ":"
		switch v := pairs[i+1].(type) {
		case int64:
			s += strconv.FormatInt(v, 10)
		case string:
			s += strconv.Quote(v)
		case bool:
			s += strconv.FormatBool(v)
		}
	}
	return s + "}"
}

// researchLink is the queue under one filter, narrowed to a search when task isn't 0.
func researchLink(q *Req, f string, task int64, page int) string {
	t := ""
	if task != 0 {
		t = strconv.FormatInt(task, 10)
	}
	return pageLink(q.Base()+"research", page, "f", f, "task", t)
}

func searchID(d ResearchData) int64 {
	if d.Search == nil {
		return 0
	}
	return d.Search.ID
}

func searchFound(v SearchView) string {
	return plural(len(v.Companies), "company") + " found"
}

func lookForText(n int) string {
	if n == 0 {
		return "Agents look for what you write. Settings › What you look for adds what they check at every company."
	}
	return "Agents check each of these, from Settings › What you look for, and record what they find as a fact with its source."
}

templ ResearchView(q *Req, d ResearchData) {
	@PageHead("Research") {
		<div class="flex flex-wrap gap-2">
			@button.Button(button.Props{Href: q.Base() + "agents", Variant: button.VariantOutline, Size: button.SizeSm}) {
				Connect an agent
			}
			if canDo(ctx, areaSales) {
				@button.Button(button.Props{Href: q.Base() + "add", Size: button.SizeSm}) {
					+ Add person
				}
			}
		</div>
	}
	<p class="mb-4 max-w-[70ch] text-sm text-muted-foreground">Say who you're looking for and an agent goes to find them. What agents, jobs and imports find waits here: nothing reaches outreach until someone qualifies it and picks a contact. Every fact keeps the link it came from.</p>
	@Whose(areaSales, "Research is")
	if canDo(ctx, areaSales) {
		@FindBox(q, d)
	}
	<div class="mb-5 flex flex-col gap-2" aria-label="Searches">
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			@Label("Searches")
			<a href={ templ.SafeURL(q.Base() + "tasks") } class="text-[13px] text-mark underline">Every search, closed ones too</a>
		</div>
		for _, s := range d.Searches {
			@SearchStrip(q, s, d.Agents, searchID(d) == s.ID)
		}
		if len(d.Searches) == 0 {
			<p class="text-sm text-muted-foreground">No search open.</p>
		}
	</div>
	<div class="flex flex-wrap items-start gap-6">
		<div class="flex min-w-0 flex-[999_1_520px] flex-col gap-3">
			<nav class="flex flex-wrap items-center gap-2" aria-label="Filter">
				for _, rf := range ResearchFilters {
					@Chip(researchLink(q, rf.Key, searchID(d), 0), rf.Label, d.Counts[rf.Key], rf.Key == d.Filter)
				}
				if d.Search != nil {
					<span class="inline-flex items-center gap-1">
						@Pill("From “"+d.Search.Title+"”", "agent")
						<a href={ templ.SafeURL(researchLink(q, d.Filter, 0, 0)) } class="px-1 text-sm text-muted-foreground no-underline" aria-label="Show every search">×</a>
					</span>
				}
			</nav>
			if d.Ranked && len(d.Rows) > 0 {
				@Meta("Best fit first: no must missed, then most met, then fewest left unknown.")
			}
			if len(d.Rows) == 0 {
				{{ t, x := researchEmpty(d.Filter) }}
				@Empty(t, x)
			}
			<div class="flex flex-col gap-3">
				for i, r := range d.Rows {
					@ResearchItem(q, r, i)
				}
			</div>
			@Pager(d.Page, func(n int) string { return researchLink(q, d.Filter, searchID(d), n) })
		</div>
		if d.Search != nil {
			<aside class="flex min-w-0 flex-[1_1_280px] flex-col gap-4">
				@SearchPanel(q, *d.Search, d.Notes)
			</aside>
		}
	</div>
}

// FindBox starts a search: a brief, and which of Prospector's agents go after it.
templ FindBox(q *Req, d ResearchData) {
	<form data-form="api/v1/tasks" data-go="research?task={id}" class="panel mb-5 overflow-hidden shadow-[4px_4px_0_var(--edge)]">
		<div class="flex flex-col gap-2.5 px-5 py-4">
			<label for="find-brief">@Label("Who are you looking for?")</label>
			<textarea id="find-brief" name="brief" rows="2" required maxlength="4000" placeholder="Heads of procurement at UK kitchen makers with their own showrooms. About twenty, with the page that shows each one's role." class="w-full rounded-lg border border-input bg-muted px-3 py-2.5 text-base leading-relaxed"></textarea>
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
					<input type="hidden" name="title" value=""/>
					if len(d.Agents) == 0 {
						<span>
							No agent of Prospector's own is ready, so this waits for one of yours.
							<a href={ templ.SafeURL(q.Base() + "agents") } class="text-mark underline">Set one up</a>
						</span>
					} else {
						<span>Send</span>
						for i, c := range d.Agents {
							<label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border-[1.5px] border-ink bg-card px-2.5 py-1 text-foreground">
								<input type="checkbox" name="agents" value={ strconv.FormatInt(c.ID, 10) } data-multi="true" data-number="true" checked?={ i == 0 } class="size-4 accent-[var(--primary)]"/>
								{ c.Name }
							</label>
						}
					}
				</div>
				<div class="flex items-center gap-3">
					<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Find
					}
				</div>
			</div>
		</div>
		<div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-border bg-secondary px-5 py-3">
			for _, a := range d.LookFor {
				<div class="flex min-w-0 flex-[1_1_280px] items-baseline gap-2">
					<span class="w-[104px] shrink-0 font-mono text-xs">{ a.Field }</span>
					<span class="min-w-0 text-sm">{ a.Hint }</span>
					if a.Must {
						<span class="font-mono text-[11px] text-mark">must</span>
					}
				</div>
			}
			<p class="w-full text-[13px] text-muted-foreground">
				{ lookForText(len(d.LookFor)) }
				<a href={ templ.SafeURL(q.Base() + "settings") } class="text-mark underline">Change them</a>
			</p>
		</div>
	</form>
}

// SearchStrip is one search: who is on it, what it has found, and the way to its companies.
templ SearchStrip(q *Req, s SearchView, agents []Agent, chosen bool) {
	<div class={ "flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border-[1.5px] border-ink bg-card px-4 py-2.5", templ.KV("shadow-[4px_4px_0_#b9aef2]", len(s.Going) > 0) }>
		<b class="font-heading text-[15px]">{ s.Title }</b>
		for _, run := range s.Going {
			@Pill(run.AgentName+" · "+agentRunState(run), "agent")
		}
		<span class="font-mono text-xs text-muted-foreground">{ searchFound(s) + " · asked by " + actorLabel(s.CreatedBy) }</span>
		<span class="ml-auto flex flex-wrap gap-2">
			if !chosen {
				@button.Button(button.Props{Href: researchLink(q, "review", s.ID, 0), Size: button.SizeSm, Variant: button.VariantOutline}) {
					Show these
				}
			}
			if canDo(ctx, areaSales) {
				for _, run := range s.Going {
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/runs/" + strconv.FormatInt(run.ID, 10) + "/stop"}}) {
						{ "Stop " + run.AgentName }
					}
				}
				for _, c := range agents {
					if !agentGoing(s.Going, c.ID) {
						@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/tasks/" + strconv.FormatInt(s.ID, 10) + "/runs", "data-body": jsonBody("agent", c.ID)}}) {
							{ "Run " + c.Name }
						}
					}
				}
			}
		</span>
	</div>
}

// SearchPanel is the chosen search beside its companies: who is working, what they
// noted, and asking for more.
templ SearchPanel(q *Req, s SearchView, notes []NoteView) {
	<section class="panel flex flex-col gap-2.5 p-5">
		@Label(s.Title)
		<p class="text-sm">{ s.Brief }</p>
		@Meta("asked by " + actorLabel(s.CreatedBy) + " · " + s.CreatedAt.Format("2 Jan"))
		for _, run := range s.Going {
			<div class="flex flex-col gap-0.5 border-t border-dashed border-border pt-2 text-sm">
				<span><b>{ run.AgentName }</b> · { agentRunState(run) }</span>
				@Meta(agentRunText(run))
			</div>
		}
		for _, run := range s.Ended {
			<div class="flex flex-col gap-0.5 border-t border-dashed border-border pt-2 text-sm">
				<span><b>{ run.AgentName }</b> · { agentRunState(run) }</span>
				@Meta(agentRunText(run))
			</div>
		}
		if len(notes) > 0 {
			<div class="flex flex-col gap-2 border-t border-dashed border-border pt-2">
				@Label("Agents' notes")
				for _, n := range notes {
					<p class="text-[13px]">
						{ n.Text }
						<span class="block font-mono text-xs text-muted-foreground">{ noteKindLabel(n.Kind) + " · " + actorLabel(n.Actor) + " · " + n.CreatedAt.Format("2 Jan 15:04") }</span>
					</p>
				}
			</div>
		}
		<a href={ taskHref(q, s.ID) } class="text-[13px] text-mark underline">Every request, note and run</a>
		if s.ClosedAt == nil && canDo(ctx, areaSales) {
			<form data-form={ "api/v1/tasks/" + strconv.FormatInt(s.ID, 10) + "/requests" } data-reset="true" data-refresh="true" class="flex flex-col gap-2 border-t border-dashed border-border pt-3">
				<label for="ask-more">@Label("Ask for more")</label>
				<textarea id="ask-more" name="text" rows="2" required maxlength="2000" placeholder="Twenty more, in Scotland this time." class="rounded-lg border border-input bg-muted px-3 py-2 text-sm leading-relaxed"></textarea>
				<div class="flex flex-wrap items-center gap-3">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Ask
					}
					<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
				</div>
			</form>
		}
	</section>
}

templ ResearchItem(q *Req, r ResearchRow, i int) {
	<article class="rise panel" style={ itemStyle(i) }>
		<div class="flex flex-wrap items-start gap-x-6 gap-y-3 px-5 py-4">
			<div class="min-w-[200px] flex-[2_1_220px]">
				<a href={ templ.SafeURL(q.Base() + "companies/" + strconv.FormatInt(r.ID, 10)) } class="font-heading text-lg font-semibold text-foreground hover:text-mark">{ r.Name }</a>
				<p class="font-mono text-xs text-muted-foreground">
					{ joinNonEmpty(" · ", r.Country, r.Segment, r.Domain) }
				</p>
			</div>
			if found := assetsFound(q.Org.Settings, r.Facts); len(found) > 0 {
				<div class="flex flex-[1_1_180px] flex-col gap-1">
					@Label("Fit")
					<span class="font-mono text-[13px] font-medium">{ fitOf(found).Text() }</span>
				</div>
			}
			<div class="flex flex-[1_1_150px] flex-col gap-1">
				@Label("Found by")
				<div>@Pill(actorLabel(r.FoundBy), actorState(r.FoundBy))</div>
				@Meta(r.CreatedAt.Format("2 Jan 15:04"))
			</div>
			if canDo(ctx, areaSales) {
				<div class="flex flex-[1_1_220px] flex-wrap items-center justify-end gap-2">
					if r.Stage != CompanyQualified {
						@FitPicker(r.Company)
						@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-post": "api/v1/companies/" + strconv.FormatInt(r.ID, 10), "data-method": "PATCH", "data-body": jsonBody("stage", CompanyQualified), "data-with-fit": "fit-" + strconv.FormatInt(r.ID, 10)}}) {
							Qualify
						}
					}
					if r.Stage != CompanyRejected {
						@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/companies/" + strconv.FormatInt(r.ID, 10), "data-method": "PATCH", "data-body": jsonBody("stage", CompanyRejected)}}) {
							Reject
						}
					}
				</div>
			}
		</div>
		for _, a := range assetsFound(q.Org.Settings, r.Facts) {
			@CriterionRow(a)
		}
		<details class="group border-t border-border/70 bg-muted" open?={ i == 0 }>
			<summary class="flex cursor-pointer list-none items-center gap-2 px-5 py-2.5 font-mono text-xs text-muted-foreground hover:text-foreground">
				<span class="transition-transform group-open:rotate-90">›</span>
				{ plural(len(otherFacts(q.Org.Settings, r.Facts)), "other fact") + " · " + plural(len(r.People), "person") }
			</summary>
			<div class="flex flex-wrap gap-6 px-5 pb-5">
				<div class="min-w-0 flex-[2_1_380px]">
					@Label("Facts")
					if r.Why != "" {
						<div class="grid grid-cols-[130px_1fr] gap-3 border-b border-dashed border-border py-2 text-sm"><span class="font-mono text-xs text-muted-foreground">why it fits</span><span>{ r.Why }</span></div>
					}
					for _, f := range otherFacts(q.Org.Settings, r.Facts) {
						@FactRow(f)
					}
				</div>
				<div class="min-w-0 flex-[1_1_260px]">
					@Label("People")
					if len(r.People) == 0 && canDo(ctx, areaSales) {
						<p class="py-2 text-sm text-muted-foreground">None yet. <a href={ templ.SafeURL(q.Base() + "add?company=" + r.Name) }>Add someone</a></p>
					} else if len(r.People) == 0 {
						<p class="py-2 text-sm text-muted-foreground">None yet.</p>
					}
					for _, p := range r.People {
						<div class="flex flex-col gap-1.5 border-b border-dashed border-border py-2.5 text-sm">
							<div><b>{ displayName(p) }</b><span class="text-muted-foreground">{ prefixed(", ", p.Title) }</span></div>
							<div class="flex flex-wrap items-center gap-2">
								switch p.EmailStatus {
									case "verified":
										@Pill("email verified", "ok")
									case "guess":
										@Pill("email is a guess", "warn")
								}
								if deref(p.Linkedin) != "" {
									<a href={ safeHref(deref(p.Linkedin)) } target="_blank" rel="noopener" class="font-mono text-xs">LinkedIn ↗</a>
								}
								if deref(p.Sources) != "" {
									<a href={ safeHref(firstLine(deref(p.Sources))) } target="_blank" rel="noopener" class="font-mono text-xs">source ↗</a>
								}
							</div>
							if p.Status == ContactSuggested && !canDo(ctx, areaSales) {
								@Meta("Suggested, waiting for someone in sales to pick them")
							} else if p.Status == ContactSuggested {
								<div>
									@button.Button(button.Props{Size: button.SizeXs, Attributes: templ.Attributes{"data-post": "api/v1/contacts/" + strconv.FormatInt(p.ID, 10) + "/pick"}}) {
										Pick: start outreach
									}
								</div>
							} else {
								@Meta(contactStage(p))
							}
							@SuggestedDetails(r.Pending[p.ID])
						</div>
					}
				</div>
			</div>
		</details>
	</article>
}

templ FitPicker(c Company) {
	<label class="sr-only" for={ "fit-" + strconv.FormatInt(c.ID, 10) }>Fit</label>
	<select id={ "fit-" + strconv.FormatInt(c.ID, 10) } class="h-8 rounded-md border border-input bg-muted px-2 font-mono text-xs">
		for _, g := range []string{"A", "B", "C"} {
			<option value={ g } selected?={ g == c.Fit || (c.Fit == "" && g == "B") }>{ "Fit " + g }</option>
		}
	</select>
}

templ AssetPills(found []AssetFound) {
	<div class="flex flex-wrap gap-1.5">
		for _, a := range found {
			{{ text, state := assetPill(a) }}
			@Pill(text, state)
		}
	</div>
}

func assetPill(a AssetFound) (string, string) {
	name := strings.ReplaceAll(a.Field, "_", " ")
	switch a.State {
	case assetMet:
		return name, "ok"
	case assetNotMet:
		return "no " + name, "stop"
	case assetNotFound:
		return name + " not found", ""
	}
	return name + " unchecked", ""
}

func assetState(a AssetFound) (string, string) {
	switch a.State {
	case assetMet:
		return "met", "ok"
	case assetNotMet:
		return "not met", "stop"
	case assetNotFound:
		return "not found", ""
	}
	return "unchecked", ""
}

// assetHow says how an answer is known: seen on their site, or inferred, and when.
func assetHow(f *Fact) string {
	how := "seen on their site"
	switch {
	case f.Answer == answerUnknown:
		how = "looked"
	case f.Inferred:
		how = "inferred"
	}
	return how + " · " + actorLabel(f.Actor) + " · " + f.CreatedAt.Format("2 Jan")
}

// CriterionRow is what a company's facts say of one thing the organisation looks for.
templ CriterionRow(a AssetFound) {
	{{ text, state := assetState(a) }}
	<div class="grid grid-cols-1 items-baseline gap-1 border-t border-dashed border-border px-5 py-2 sm:grid-cols-[168px_96px_1fr] sm:gap-3">
		<span class="font-mono text-xs text-muted-foreground">
			{ a.Field }
			if a.Must {
				<span class="text-mark">· must</span>
			}
		</span>
		<span>@Pill(text, state)</span>
		<span class="min-w-0 text-sm">
			if a.Fact == nil {
				<span class="text-muted-foreground">No agent has checked this yet.</span>
			} else {
				{ a.Fact.Value }
				<span class="block font-mono text-[11px] text-muted-foreground">
					{ assetHow(a.Fact) }
					if a.Fact.SourceURL != "" {
						· <a href={ templ.SafeURL(a.Fact.SourceURL) } target="_blank" rel="noopener noreferrer" class="text-mark underline">source ↗</a>
					}
				</span>
			}
		</span>
	</div>
}

func detailLabel(field string) string {
	switch field {
	case "linkedin":
		return "LinkedIn profile"
	case "phone":
		return "phone number"
	}
	return field
}

func suggestedNote(d PendingDetail) string {
	var notes []string
	if d.EmailStatus == "guess" {
		notes = append(notes, "a guess")
	}
	if d.Current != "" {
		notes = append(notes, "in place of "+d.Current)
	}
	return strings.Join(notes, ", ")
}

templ SuggestedDetails(list []PendingDetail) {
	for _, d := range list {
		<div class="flex flex-wrap items-center gap-2 rounded-lg bg-muted p-3 text-sm">
			<span class="min-w-0 flex-[1_1_220px]">
				<span class="font-mono text-xs text-muted-foreground">{ "suggested " + detailLabel(d.Field) }</span>
				<span class="block break-all">{ d.Value }</span>
				if note := suggestedNote(d); note != "" {
					<span class="block text-muted-foreground">{ note }</span>
				}
				<span class="flex flex-wrap items-center gap-2">
					<span class="font-mono text-xs text-mark">{ actorLabel(d.By) }</span>
					if d.SourceURL != "" {
						<a href={ safeHref(d.SourceURL) } target="_blank" rel="noopener" class="font-mono text-xs">source ↗</a>
					}
				</span>
			</span>
			if canDo(ctx, areaSales) {
				@button.Button(button.Props{Size: button.SizeXs, Attributes: templ.Attributes{"data-post": "api/v1/suggestions/" + strconv.FormatInt(d.ID, 10), "data-method": "PATCH", "data-body": jsonBody("decision", SuggestionAccepted)}}) {
					Accept
				}
				@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/suggestions/" + strconv.FormatInt(d.ID, 10), "data-method": "PATCH", "data-body": jsonBody("decision", SuggestionDismissed)}}) {
					Dismiss
				}
			}
		</div>
	}
}
