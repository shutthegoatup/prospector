package main

import (
	"fmt"
	"github.com/shutthegoatup/prospector/components"
	"github.com/shutthegoatup/prospector/components/button"
	"strconv"
	"strings"
)

templ Head(title string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="color-scheme" content="light"/>
	<title>{ title }</title>
	<link rel="icon" type="image/svg+xml" href={ "/assets/img/mark.svg?v=" + assetVersion }/>
	<link rel="stylesheet" href={ "/assets/css/fonts.css?v=" + assetVersion }/>
	<link rel="stylesheet" href={ "/assets/css/output.css?v=" + assetVersion }/>
	@components.Scripts()
	<script src={ "/assets/js/app.js?v=" + assetVersion } defer></script>
}

templ ProblemPage(code int, title, message, back string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head(title + " · Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased" data-base="/">
			<main class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
				<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{ strconv.Itoa(code) }</span>
				<h1 class="font-heading text-2xl font-bold">{ title }<span class="text-coral">.</span></h1>
				<p class="text-sm text-muted-foreground" role="alert">{ message }</p>
				@button.Button(button.Props{Href: back, Size: button.SizeLg}) {
					Back to Prospector
				}
			</main>
		</body>
	</html>
}

templ NoOrgs(u *User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head("Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased" data-base="/">
			<form data-form="/api/v1/orgs" data-go="/o/{slug}/settings" class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
				<h1 class="font-heading text-2xl font-bold">Your first organisation</h1>
				<p class="text-sm text-muted-foreground">The company you're prospecting for. You can add more later and switch between them.</p>
				<input name="name" required placeholder="Organisation name" class="h-10 rounded-lg border border-input bg-muted px-3"/>
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Create
				}
				<p data-result class="text-sm text-muted-foreground"></p>
			</form>
		</body>
	</html>
}

func plural(n int, word string) string {
	if n == 1 {
		return "1 " + word
	}
	switch {
	case word == "person":
		word = "people"
	case strings.HasSuffix(word, "y") && !strings.ContainsAny(word[len(word)-2:len(word)-1], "aeiou"):
		word = word[:len(word)-1] + "ies"
	default:
		word += "s"
	}
	return fmt.Sprintf("%d %s", n, word)
}

func actorLabel(actor string) string {
	if actor == customerActor {
		return "the customer"
	}
	if a, ok := strings.CutPrefix(actor, "agent:"); ok {
		return "agent · " + a
	}
	return actor
}
