package main

import (
	"fmt"
	"github.com/shutthegoatup/prospector/components"
	"github.com/shutthegoatup/prospector/components/button"
	"net/url"
	"strconv"
	"strings"
)

templ Head(title string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="color-scheme" content="light"/>
	<title>{ title }</title>
	<link rel="icon" type="image/svg+xml" href={ "/assets/img/mark.svg?v=" + assetVersion }/>
	<link rel="stylesheet" href={ "/assets/css/fonts.css?v=" + assetVersion }/>
	<link rel="stylesheet" href={ "/assets/css/output.css?v=" + assetVersion }/>
	@components.Scripts()
	<script src={ "/assets/js/app.js?v=" + assetVersion } defer></script>
}

templ LoginPage(v LoginView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head("Sign in · Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased">
			<main class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
				<h1 class="flex items-center gap-2.5 font-heading text-2xl font-bold"><img src={ "/assets/img/mark.svg?v=" + assetVersion } width="30" height="30" alt=""/>Prospector.</h1>
				if v.Problem != "" {
					<p class="text-sm text-[var(--stop)]" role="alert">{ v.Problem }</p>
				}
				if v.Notice != "" {
					<p class="text-sm text-[var(--ok)]" role="status">{ v.Notice }</p>
				}
				<form method="post" action="/login" class="flex flex-col gap-4">
					<input type="hidden" name="next" value={ v.Next }/>
					<label class="flex flex-col gap-1.5 text-sm">
						<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Email</span>
						<input name="email" type="email" required autocomplete="username" class="h-10 rounded-lg border border-input bg-muted px-3"/>
					</label>
					<label class="flex flex-col gap-1.5 text-sm">
						<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Password</span>
						<input name="password" type="password" required autocomplete="current-password" class="h-10 rounded-lg border border-input bg-muted px-3"/>
					</label>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg}) {
						Sign in
					}
					if v.Forgot {
						<a href="/forgot" class="text-sm text-muted-foreground hover:text-foreground">Forgot your password?</a>
					}
				</form>
				if len(v.Ways) > 0 || v.SSO {
					<nav class="flex flex-col gap-2 border-t border-dashed border-border pt-2" aria-label="Other ways to sign in">
						<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Or</span>
						for _, way := range v.Ways {
							@button.Button(button.Props{Href: "/login/with/" + way.Key + nextQuery(v.Next), Variant: button.VariantOutline}) {
								Continue with { way.Label }
							}
						}
						if v.SSO {
							@button.Button(button.Props{Href: "/login/sso" + nextQuery(v.Next), Variant: button.VariantOutline}) {
								Use your organisation's single sign-on
							}
						}
					</nav>
				}
			</main>
		</body>
	</html>
}

templ ForgotPage(sent bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head("Reset your password · Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased">
			<form method="post" action="/forgot" class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
				<h1 class="font-heading text-2xl font-bold">Reset your password</h1>
				if sent {
					<p class="text-sm text-[var(--ok)]" role="status">If that address has an account, a link is on its way. It lasts an hour.</p>
				} else {
					<p class="text-sm text-muted-foreground">We'll email you a link to choose a new one.</p>
				}
				<label class="flex flex-col gap-1.5 text-sm">
					<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Email</span>
					<input name="email" type="email" required autocomplete="username" class="h-10 rounded-lg border border-input bg-muted px-3"/>
				</label>
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg}) {
					Email me a link
				}
				<a href="/login" class="text-sm text-muted-foreground hover:text-foreground">Back to sign in</a>
			</form>
		</body>
	</html>
}

templ ResetPage(token, email, problem string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head("Choose a password · Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased">
			<form method="post" action={ templ.SafeURL("/reset/" + token) } class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
				<h1 class="font-heading text-2xl font-bold">Choose a password</h1>
				<p class="text-sm text-muted-foreground">For { email }. 10 characters or more.</p>
				if problem != "" {
					<p class="text-sm text-[var(--stop)]" role="alert">{ problem }</p>
				}
				<label class="flex flex-col gap-1.5 text-sm">
					<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">New password</span>
					<input name="password" type="password" required minlength="10" autocomplete="new-password" class="h-10 rounded-lg border border-input bg-muted px-3"/>
				</label>
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg}) {
					Save password
				}
			</form>
		</body>
	</html>
}

func nextQuery(next string) string {
	if next == "" {
		return ""
	}
	return "?next=" + url.QueryEscape(next)
}

// SSOPage answers with links and never a redirect: a form here may only end on this site.
templ SSOPage(v SSOView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head("Single sign-on · Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased">
			<main class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
				<h1 class="font-heading text-2xl font-bold">Single sign-on<span class="text-coral">.</span></h1>
				if v.Problem != "" {
					<p class="text-sm text-[var(--stop)]" role="alert">{ v.Problem }</p>
				}
				if v.Asked != "" {
					<p class="text-sm text-muted-foreground">{ v.Asked } asks its people to sign in through its own provider.</p>
				}
				for _, o := range v.Orgs {
					@button.Button(button.Props{Href: ssoStartURL(&o, v.Email, v.Next), Size: button.SizeLg}) {
						Continue to { o.Name }
					}
				}
				<form method="get" action="/login/sso" class="flex flex-col gap-4">
					<input type="hidden" name="next" value={ v.Next }/>
					<label class="flex flex-col gap-1.5 text-sm">
						<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Work email</span>
						<input name="email" type="email" required autocomplete="username" value={ v.Email } class="h-10 rounded-lg border border-input bg-muted px-3"/>
					</label>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
						Find my organisation
					}
				</form>
				<a href={ templ.SafeURL("/login" + nextQuery(v.Next)) } class="text-sm text-muted-foreground hover:text-foreground">Sign in with a password instead</a>
			</main>
		</body>
	</html>
}

templ ProblemPage(code int, title, message string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head(title + " · Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased" data-base="/">
			<main class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
				<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{ strconv.Itoa(code) }</span>
				<h1 class="font-heading text-2xl font-bold">{ title }<span class="text-coral">.</span></h1>
				<p class="text-sm text-muted-foreground" role="alert">{ message }</p>
				@button.Button(button.Props{Href: "/", Size: button.SizeLg}) {
					Back to Prospector
				}
			</main>
		</body>
	</html>
}

templ ChoosePassword(u *User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head("Choose a password · Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased" data-base="/">
			<div class="flex w-full max-w-sm flex-col gap-4">
				<form data-form="/password" class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
					<h1 class="font-heading text-2xl font-bold">Choose your own password</h1>
					<p class="text-sm text-muted-foreground">The one you signed in with was shown to whoever added you. Choose one only you know, 10 characters or more.</p>
					<label class="flex flex-col gap-1.5 text-sm">
						<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Password you were given</span>
						<input name="current" type="password" required autocomplete="current-password" class="h-10 rounded-lg border border-input bg-muted px-3"/>
					</label>
					<label class="flex flex-col gap-1.5 text-sm">
						<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">New password</span>
						<input name="new" type="password" required minlength="10" autocomplete="new-password" class="h-10 rounded-lg border border-input bg-muted px-3"/>
					</label>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg}) {
						Continue
					}
					<p data-result class="text-sm text-muted-foreground" role="status"></p>
				</form>
				<form method="post" action="/logout" class="flex items-center gap-2.5 px-2.5 text-sm text-muted-foreground">
					<span class="flex-1 truncate">{ u.Email }</span>
					<button type="submit" class="text-xs hover:text-foreground">Sign out</button>
				</form>
			</div>
		</body>
	</html>
}

templ NoOrgs(u *User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head("Prospector")
		</head>
		<body class="front-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased" data-base="/">
			<form data-form="/api/v1/orgs" data-go="/o/{slug}/settings" class="flex w-full max-w-sm flex-col gap-4 panel panel-lift p-7">
				<h1 class="font-heading text-2xl font-bold">Your first organisation</h1>
				<p class="text-sm text-muted-foreground">The company you're prospecting for. You can add more later and switch between them.</p>
				<input name="name" required placeholder="Organisation name" class="h-10 rounded-lg border border-input bg-muted px-3"/>
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Create
				}
				<p data-result class="text-sm text-muted-foreground"></p>
			</form>
		</body>
	</html>
}

func plural(n int, word string) string {
	if n == 1 {
		return "1 " + word
	}
	switch {
	case word == "person":
		word = "people"
	case strings.HasSuffix(word, "y") && !strings.ContainsAny(word[len(word)-2:len(word)-1], "aeiou"):
		word = word[:len(word)-1] + "ies"
	default:
		word += "s"
	}
	return fmt.Sprintf("%d %s", n, word)
}

func actorLabel(actor string) string {
	if actor == customerActor {
		return "the customer"
	}
	if a, ok := strings.CutPrefix(actor, "agent:"); ok {
		return "agent · " + a
	}
	return actor
}
