package main

import (
	"fmt"
	"github.com/shutthegoatup/prospector/components"
	"github.com/shutthegoatup/prospector/components/button"
	"strconv"
	"strings"
)

templ Head(title string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="color-scheme" content="dark"/>
	<title>{ title }</title>
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"/>
	<link rel="stylesheet" href={ "/assets/css/output.css?v=" + assetVersion }/>
	@components.Scripts()
	<script src={ "/assets/js/app.js?v=" + assetVersion } defer></script>
}

func navLink(n Nav, key string) string {
	if n.Active == key {
		return "flex items-center justify-between rounded-lg bg-card px-3 py-2 text-sm text-foreground shadow-[inset_2px_0_0_var(--primary)]"
	}
	return "flex items-center justify-between rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-card hover:text-foreground"
}

func initial(s string) string {
	for _, r := range s {
		return strings.ToUpper(string(r))
	}
	return "?"
}

templ OrgMark(name, color string, size string) {
	<span class={ "grid shrink-0 place-items-center rounded-md font-heading font-bold text-[#111]", size } style={ "background:" + color }>{ initial(name) }</span>
}

templ NavItem(n Nav, key, label string, count int) {
	<a href={ templ.SafeURL(n.Base() + key) } class={ navLink(n, key) }>
		<span>{ label }</span>
		if count > 0 {
			<span class="font-mono text-xs text-muted-foreground">{ strconv.Itoa(count) }</span>
		}
	</a>
}

templ Layout(n Nav, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			@Head(n.Org.Name + " · Prospector")
		</head>
		<body class="queue-backdrop min-h-svh font-sans text-[15px] leading-relaxed antialiased" data-base={ n.Base() }>
			<div class="flex min-h-svh flex-wrap">
				<aside class="flex max-w-full flex-[1_1_240px] flex-col gap-4 border-r border-border bg-[#151515] px-3.5 py-5 md:sticky md:top-0 md:h-svh md:max-w-[260px]">
					<details class="group relative">
						<summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-xl border border-border bg-[#1d1d1d] px-2.5 py-2">
							@OrgMark(n.Org.Name, n.Org.Color, "size-7 text-sm")
							<span class="flex min-w-0 flex-1 flex-col leading-tight">
								<span class="truncate text-sm font-semibold">{ n.Org.Name }</span>
								<span class="font-mono text-xs text-muted-foreground">organisation</span>
							</span>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground" aria-hidden="true"><path d="M7 10l5-5 5 5M7 14l5 5 5-5"></path></svg>
						</summary>
						<div class="absolute inset-x-0 top-full z-20 mt-2 flex flex-col gap-0.5 rounded-xl border border-[#333] bg-card p-2 shadow-2xl">
							<p class="px-2 py-1 font-mono text-xs text-muted-foreground">{ n.User.Email }</p>
							for _, o := range n.Orgs {
								<a href={ templ.SafeURL("/o/" + o.Slug + "/today") } class="flex items-center gap-3 rounded-lg px-2 py-2 text-sm text-foreground hover:bg-[#2a2a2a]">
									@OrgMark(o.Name, o.Color, "size-7 text-sm")
									<span class="flex-1">{ o.Name }<span class="block font-mono text-xs text-muted-foreground">{ o.Role }</span></span>
									if o.ID == n.Org.ID {
										<span class="text-primary" aria-label="current">✓</span>
									}
								</a>
							}
							<form data-form="/orgs" class="mt-1 flex gap-2 border-t border-[#333] px-1 pt-2">
								<label class="sr-only" for="new-org">New organisation</label>
								<input id="new-org" name="name" required placeholder="New organisation" class="h-8 min-w-0 flex-1 rounded-md border border-input bg-muted px-2 text-sm"/>
								@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Type: button.TypeSubmit}) {
									Add
								}
							</form>
						</div>
					</details>
					@button.Button(button.Props{Href: n.Base() + "add", Class: "w-full"}) {
						+ Add person
					}
					<nav class="flex flex-col gap-0.5" aria-label="Main">
						@NavItem(n, "today", "Today", n.Today)
						@NavItem(n, "research", "Research", n.Research)
						@NavItem(n, "conversations", "Conversations", n.Conversations)
						@NavItem(n, "companies", "Companies", n.Companies)
						@NavItem(n, "settings", "Settings", 0)
						@NavItem(n, "agents", "Agents & API", 0)
					</nav>
					<form method="post" action="/logout" class="mt-auto flex items-center gap-2.5 px-2.5 text-sm text-muted-foreground">
						<span class="grid size-6 place-items-center rounded-full bg-secondary text-xs text-foreground">{ initial(n.User.Name + n.User.Email) }</span>
						<span class="flex-1 truncate">{ n.User.Name }</span>
						<button type="submit" class="text-xs hover:text-foreground">Sign out</button>
					</form>
				</aside>
				<main id="content" class="relative min-w-0 flex-[999_1_640px] px-4 pb-16 pt-7 sm:px-8 lg:px-12" style={ "--org:" + n.Org.Color }>
					@content
				</main>
			</div>
		</body>
	</html>
}

templ PageHead(title string) {
	<header class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
		<h1 class="font-heading text-3xl font-bold tracking-tight">{ title }<span class="text-primary">.</span></h1>
		{ children... }
	</header>
}

templ LoginPage(next, problem string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			@Head("Sign in · Prospector")
		</head>
		<body class="queue-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased">
			<form method="post" action="/login" class="flex w-full max-w-sm flex-col gap-4 rounded-2xl border border-border bg-card p-7">
				<h1 class="font-heading text-2xl font-bold">Prospector<span class="text-primary">.</span></h1>
				if problem != "" {
					<p class="text-sm text-[var(--stop)]" role="alert">{ problem }</p>
				}
				<input type="hidden" name="next" value={ next }/>
				<label class="flex flex-col gap-1.5 text-sm">
					<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Email</span>
					<input name="email" type="email" required autocomplete="username" class="h-10 rounded-lg border border-input bg-muted px-3"/>
				</label>
				<label class="flex flex-col gap-1.5 text-sm">
					<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Password</span>
					<input name="password" type="password" required autocomplete="current-password" class="h-10 rounded-lg border border-input bg-muted px-3"/>
				</label>
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg}) {
					Sign in
				}
			</form>
		</body>
	</html>
}

templ NoOrgs(u *User) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			@Head("Prospector")
		</head>
		<body class="queue-backdrop grid min-h-svh place-items-center px-4 font-sans antialiased" data-base="/">
			<form data-form="/orgs" class="flex w-full max-w-sm flex-col gap-4 rounded-2xl border border-border bg-card p-7">
				<h1 class="font-heading text-2xl font-bold">Your first organisation</h1>
				<p class="text-sm text-muted-foreground">The company you're prospecting for. You can add more later and switch between them.</p>
				<input name="name" required placeholder="Organisation name" class="h-10 rounded-lg border border-input bg-muted px-3"/>
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Create
				}
				<p data-result class="text-sm text-muted-foreground"></p>
			</form>
		</body>
	</html>
}

func plural(n int, word string) string {
	if n == 1 {
		return "1 " + word
	}
	switch {
	case word == "person":
		word = "people"
	case strings.HasSuffix(word, "y") && !strings.ContainsAny(word[len(word)-2:len(word)-1], "aeiou"):
		word = word[:len(word)-1] + "ies"
	default:
		word += "s"
	}
	return fmt.Sprintf("%d %s", n, word)
}

func badgeClass(state string) string {
	switch state {
	case "ok":
		return "text-[var(--ok)] bg-[color-mix(in_oklab,var(--ok)_12%,transparent)]"
	case "warn":
		return "text-[var(--warn)] bg-[color-mix(in_oklab,var(--warn)_12%,transparent)]"
	case "stop":
		return "text-[var(--stop)] bg-[color-mix(in_oklab,var(--stop)_12%,transparent)]"
	case "agent":
		return "text-primary bg-[color-mix(in_oklab,var(--primary)_12%,transparent)]"
	}
	return "text-muted-foreground bg-secondary"
}

templ Pill(text, state string) {
	<span class={ "inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-medium", badgeClass(state) }>
		<span class="size-1.5 rounded-full bg-current"></span>
		{ text }
	</span>
}

templ Meta(s string) {
	<p class="font-mono text-xs text-muted-foreground">{ s }</p>
}

templ Label(text string) {
	<span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{ text }</span>
}

templ Quote(s string) {
	<div class="whitespace-pre-wrap rounded-lg border-l-2 border-primary/50 bg-muted px-4 py-3 text-[15px] leading-relaxed">{ s }</div>
}

templ Empty(title, text string) {
	<div class="rounded-xl border border-dashed border-border px-6 py-14 text-center text-muted-foreground">
		<p class="font-heading text-lg text-foreground">{ title }</p>
		<p class="mt-1 text-sm">{ text }</p>
	</div>
}

templ Chip(href, label string, count int, on bool) {
	<a href={ templ.SafeURL(href) } class={ "inline-flex min-h-8 items-center gap-1.5 rounded-full border px-3 text-sm font-medium transition-colors", chipClass(on) }>
		{ label }
		<span class="font-mono text-xs opacity-80">{ strconv.Itoa(count) }</span>
	</a>
}

func chipClass(on bool) string {
	if on {
		return "border-primary bg-primary text-primary-foreground"
	}
	return "border-input text-muted-foreground hover:text-foreground"
}

func actorState(actor string) string {
	if strings.HasPrefix(actor, "agent:") {
		return "agent"
	}
	return ""
}

func actorLabel(actor string) string {
	if a, ok := strings.CutPrefix(actor, "agent:"); ok {
		return "agent · " + a
	}
	return actor
}
