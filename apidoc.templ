package main

templ Spans(s string) {
	for _, sp := range codeSpans(s) {
		if sp.Code {
			<code>{ sp.Text }</code>
		} else {
			{ sp.Text }
		}
	}
}

templ TypeName(doc APIDoc, t string) {
	if link := schemaLink(doc, t); link != "" {
		<a class="api-type" href={ templ.SafeURL(link) }>{ t }</a>
	} else {
		<span class="api-type">{ t }</span>
	}
}

templ Fields(doc APIDoc, fields []APIField) {
	<dl class="api-fields">
		for _, f := range fields {
			<div class="api-field">
				<dt>
					<code class="api-name">{ f.Name }</code>
					@TypeName(doc, f.Type)
					if f.Required {
						<span class="api-flag is-req">required</span>
					}
					if f.Write {
						<span class="api-flag">write-only</span>
					}
				</dt>
				if f.About != "" {
					<dd>
						@Spans(f.About)
					</dd>
				}
			</div>
		}
	</dl>
}

templ APIPage(doc APIDoc) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#ffc233"/>
			<title>Prospector API · The contract</title>
			<meta name="description" content="Everything Prospector does, as an HTTP API for people and robots alike: agents, runs and more, with the OpenAPI spec to build against."/>
			<link rel="icon" type="image/svg+xml" href={ asset("img/mark.svg") }/>
			<link rel="stylesheet" href={ asset("css/fonts.css") }/>
			<link rel="stylesheet" href={ asset("css/landing.css") }/>
			<link rel="stylesheet" href={ asset("css/api.css") }/>
		</head>
		<body class="lp api">
			<header class="api-top">
				<div class="lp-wrap">
					<nav class="lp-nav" aria-label="Site">
						@Brand()
						<div class="lp-links">
							<a href="/">Product</a>
							<a href="#auth">Authentication</a>
							<a href="#schemas">Schemas</a>
						</div>
						<a class="lp-btn is-small" href="/api/openapi.json">openapi.json</a>
					</nav>
					<div class="api-hero">
						<p class="lp-label">{ doc.Title } API · v{ doc.Version } · OpenAPI 3</p>
						<h1>The contract.</h1>
						for _, p := range doc.Intro {
							<p class="api-lede">
								@Spans(p)
							</p>
						}
					</div>
				</div>
			</header>
			<div class="lp-wrap api-body">
				<aside class="api-side" aria-label="Contents">
					<p class="lp-label">Start</p>
					<a href="#auth">Authentication</a>
					<a href="#errors">Errors</a>
					for _, g := range doc.Groups {
						<p class="lp-label">{ g.Name }</p>
						for _, o := range g.Ops {
							<a href={ templ.SafeURL("#" + opAnchor(o)) }><span class={ "api-m", methodTone(o.Method) }>{ o.Method }</span>{ o.Summary }</a>
						}
					}
					<p class="lp-label">Schemas</p>
					for _, s := range doc.Schemas {
						<a href={ templ.SafeURL("#" + schemaAnchor(s.Name)) }>{ s.Name }</a>
					}
				</aside>
				<main class="api-main">
					<section id="auth" class="api-section">
						<h2>Authentication</h2>
						<p>Send an API key made on your organisation's Agents page as a bearer token. Every path starts with your organisation's slug, and a key only opens its own organisation.</p>
						<pre class="api-code"><code>Authorization: Bearer pk_…</code></pre>
						<p>Prospector's own pages use the same API with the signed-in session. A member can read and run; changing settings needs an owner.</p>
						<table class="api-table">
							<thead><tr><th>Scope</th><th>Lets a key</th></tr></thead>
							<tbody>
								for _, s := range doc.Scopes {
									<tr>
										<td>
											<code>{ s.Name }</code>
											if s.Owner {
												<span class="api-flag">owner-level</span>
											}
										</td>
										<td>{ s.What }</td>
									</tr>
								}
							</tbody>
						</table>
					</section>
					<section id="errors" class="api-section">
						<h2>Errors</h2>
						<p>A failure answers with its status and an <a href="https://www.rfc-editor.org/rfc/rfc9457">RFC 9457</a> problem, whose <code>detail</code> says what to change.</p>
						<pre class="api-code"><code>{ `HTTP/1.1 403 Forbidden
Content-Type: application/problem+json

{"type":"about:blank","title":"Forbidden","status":403,"detail":"this key lacks the agents:configure scope"}` }</code></pre>
					</section>
					for _, g := range doc.Groups {
						<section class="api-section">
							<h2 class="api-group">{ g.Name }</h2>
							if g.About != "" {
								<p class="api-soft">
									@Spans(g.About)
								</p>
							}
							for _, o := range g.Ops {
								<article id={ opAnchor(o) } class="api-op">
									<header class="api-op-head">
										<span class={ "api-m", "is-big", methodTone(o.Method) }>{ o.Method }</span>
										<code class="api-path">{ o.Path }</code>
									</header>
									<h3>{ o.Summary }</h3>
									if o.About != "" {
										<p>
											@Spans(o.About)
										</p>
									}
									<p class="api-scope">
										if o.Scope != "" {
											Key scope <code>{ o.Scope }</code>
										}
										if o.OwnerOnly {
											<span class="api-flag">owner, when signed in</span>
										}
									</p>
									<div class="api-op-grid">
										<div>
											if len(o.Params) > 0 {
												<h4>Path</h4>
												@Fields(doc, o.Params)
											}
											if o.Body != nil {
												<h4>
													Body
													if o.Body.Of != "" {
														@TypeName(doc, o.Body.Of)
													}
												</h4>
												@Fields(doc, o.Body.Fields)
											}
											<h4>Responses</h4>
											<dl class="api-fields">
												for _, r := range o.Responses {
													<div class="api-field">
														<dt>
															<span class={ "api-code-tag", templ.KV("is-bad", r.Code == "4xx · 5xx") }>{ r.Code }</span>
															if r.Type != "" {
																@TypeName(doc, r.Type)
															}
														</dt>
														<dd>{ r.About }</dd>
													</div>
												}
											</dl>
										</div>
										<pre class="api-code is-dark"><code>{ curlOf(doc.Base, o) }</code></pre>
									</div>
								</article>
							}
						</section>
					}
					<section id="schemas" class="api-section">
						<h2>Schemas</h2>
						for _, s := range doc.Schemas {
							<article id={ schemaAnchor(s.Name) } class="api-schema">
								<h3><code>{ s.Name }</code></h3>
								if s.About != "" {
									<p>
										@Spans(s.About)
									</p>
								}
								if len(s.Enum) > 0 {
									<p class="api-enum">
										for _, e := range s.Enum {
											<code>{ e }</code>
										}
									</p>
								}
								if len(s.Fields) > 0 {
									@Fields(doc, s.Fields)
								}
							</article>
						}
					</section>
				</main>
			</div>
			<footer class="lp-foot">
				<div class="lp-wrap">
					@Brand()
					<span>The spec is <a href="/api/openapi.json">openapi.json</a>; generate a client from it in any language.</span>
					<nav aria-label="Footer">
						<a href={ templ.SafeURL(repoURL) }>GitHub</a>
						<a href="/">Product</a>
						<a href="/login">Sign in</a>
					</nav>
				</div>
			</footer>
		</body>
	</html>
}
