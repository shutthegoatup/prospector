package main

const repoURL = "https://github.com/shutthegoatup/prospector"

func asset(path string) string {
	return "/assets/" + path + "?v=" + assetVersion
}

templ Brand() {
	<a class="lp-brand" href="/"><img src={ asset("img/mark.svg") } width="30" height="30" alt=""/><span>Prospector.</span></a>
}

templ Shot(file, width, height, alt, tone string) {
	<div class={ "lp-shot", tone }><img src={ asset("img/" + file) } width={ width } height={ height } loading="lazy" alt={ alt }/></div>
}

// LandingPage takes the address its enquiry form posts to, and the origin that address
// answers; with none it has no form and loads no script.
templ LandingPage(intake, origin string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#ffc233"/>
			<title>Prospector · A few hundred accounts, one queue a day</title>
			<meta name="description" content="A prospecting and customer workbench for small teams selling to named accounts: research, deals, subscriptions and onboarding on one company record. Agents research and draft; you decide what they may send."/>
			<link rel="icon" type="image/svg+xml" href={ asset("img/mark.svg") }/>
			<link rel="stylesheet" href={ asset("css/fonts.css") }/>
			<link rel="stylesheet" href={ asset("css/landing.css") }/>
			if intake != "" {
				<script src={ asset("js/landing.js") } defer></script>
			}
		</head>
		<body class="lp">
			<header class="lp-hero">
				<img class="lp-contours" src={ asset("img/contours.svg") } alt=""/>
				<div class="lp-wrap">
					<nav class="lp-nav" aria-label="Site">
						@Brand()
						<div class="lp-links">
							<a href="#loop">How it works</a>
							<a href="#customers">Customers</a>
							<a href="#agents">Agents</a>
							<a href="#start">Get started</a>
							if intake != "" {
								<a href="#contact" data-needs-script hidden>Contact</a>
							}
						</div>
						<a class="lp-btn is-small" href="/login">Sign in</a>
					</nav>
					<div class="lp-hero-grid">
						<div class="lp-hero-copy">
							<p class="lp-label">Account-based prospecting for small teams</p>
							<h1><span>A few hundred accounts.</span><span>One queue a day.</span><span>Every fact <em>sourced.</em></span></h1>
							<p class="lp-lede">Prospector is a prospecting workbench for teams selling to named accounts. Agents research companies and draft messages. People qualify, decide and send.</p>
							<div class="lp-cta">
								<a class="lp-btn is-primary" href="#start">Get started</a>
								<a class="lp-btn" href="#loop">See how it works</a>
							</div>
						</div>
						<div class="lp-stage">
							<div class="lp-window">
								<div class="lp-window-bar"><i></i><i></i><i></i><span>prospector.example.com/o/example-co/today</span></div>
								<img src={ asset("img/today.webp") } width="1440" height="900" alt="The Today page: everything due, best first, with a Do now list beside them"/>
							</div>
							<span class="lp-chip is-green a">Tue 16:39 in London: good time to call</span>
							<span class="lp-chip is-violet b">agent · research-agent</span>
						</div>
					</div>
				</div>
			</header>
			<div class="lp-wrap">
				<div class="lp-facts">
					<div class="lp-fact is-coral"><b>1</b><p><strong>queue a day</strong>across LinkedIn, email and phone.</p></div>
					<div class="lp-fact is-violet"><b>0</b><p><strong>messages sent by agents</strong>They draft. Only people send.</p></div>
					<div class="lp-fact is-green"><b>1</b><p><strong>source link per fact</strong>An agent's fact without one is refused.</p></div>
				</div>
			</div>
			<section class="lp-section" id="loop">
				<div class="lp-wrap">
					<div class="lp-section-head">
						<p class="lp-label">How it works</p>
						<h2>From a company name to a signed deal, in three pages.</h2>
						<p>Research fills the list. Today works it. Conversations closes it. The screenshots show invented companies and people.</p>
					</div>
					<div class="lp-step is-green">
						<div class="lp-step-copy">
							<span class="lp-tag">01 · Research</span>
							<h3>Facts with the link they came from</h3>
							<p>Companies found by agents, imports and people wait here until someone qualifies or rejects them. Nothing reaches outreach on its own.</p>
							<p>Every fact keeps its source. Pick a suggested person and they move into outreach with a note from your template.</p>
						</div>
						@Shot("research.webp", "1440", "900", "Research: two companies an agent found, each with sourced facts and a suggested contact", "")
					</div>
					<div class="lp-step is-flipped is-gold">
						<div class="lp-step-copy">
							<span class="lp-tag">02 · Today</span>
							<h3>One queue, best first</h3>
							<p>Everything due across LinkedIn, email and phone, in this order:</p>
							<ol>
								<li>Conversations that need a next step</li>
								<li>Calls where it's office hours for the contact</li>
								<li>LinkedIn messages, emails and follow-ups</li>
								<li>LinkedIn adds</li>
							</ol>
							<div class="lp-keys">
								<span><kbd>o</kbd>open and copy the note</span>
								<span><kbd>a</kbd>added</span>
								<span><kbd>s</kbd>skip</span>
							</div>
						</div>
						@Shot("linkedin.webp", "1440", "900", "The LinkedIn queue: the connection note ready to copy, with keyboard shortcuts", "")
					</div>
					<div class="lp-step is-coral">
						<div class="lp-step-copy">
							<span class="lp-tag">03 · Conversations</span>
							<h3>Replies become deals</h3>
							<p>Replies move across a board: replied, meeting, proposal, won, lost.</p>
							<p>Each one needs a next step with a date. Any without one, or due today, come back to the top of Today.</p>
						</div>
						@Shot("conversations.webp", "1440", "560", "Conversations: a board from replied to won", "")
					</div>
				</div>
			</section>
			<section class="lp-section" id="customers">
				<div class="lp-wrap">
					<div class="lp-section-head">
						<p class="lp-label">After it's won</p>
						<h2>The customer stays on the same record.</h2>
						<p>Deals, what they're on, getting them live, what they write in about and what you write to them all, on the company you prospected. Each has its operations in the published API.</p>
					</div>
					<div class="lp-grid">
						<div class="lp-cell is-coral"><h3>Deals with a value</h3><p>Each conversation carries what it's worth, who has it and when it should close. Start a second one for a renewal or an expansion.</p></div>
						<div class="lp-cell is-gold"><h3>Subscriptions and their notice</h3><p>What each customer is on, for how long, and the notice it needs. Today flags one a month before its date to give notice or renew, and a renewal deal starts from it.</p></div>
						<div class="lp-cell is-green"><h3>Onboarding to go-live</h3><p>Your steps and theirs, dated from the start. A won deal offers to start one, and late steps come back to Today.</p></div>
						<div class="lp-cell is-violet"><h3>A page for the customer</h3><p>Invite someone at the company to a page of their own steps, opened from an emailed link with no password. They mark theirs done.</p></div>
						<div class="lp-cell is-coral"><h3>Enquiries answered</h3><p>Site forms and your product's sign-ups arrive open on the card, to be given an owner. Reply by email from it, and paste their answer into the thread.</p></div>
						<div class="lp-cell is-gold"><h3>Campaigns to people you know</h3><p>Write once to everyone in conversation or at a current customer, never to cold prospects. It goes through your own mail server with your postal address and a one-click unsubscribe, and nobody is mailed twice. A service notice, such as a price change, reaches customers who unsubscribed from marketing.</p></div>
					</div>
				</div>
			</section>
			<section class="lp-night" id="agents">
				<div class="lp-wrap">
					<div class="lp-section-head">
						<span class="lp-tag is-violet">Agents and API</span>
						<h2>Agents do the reading. You decide what they may send.</h2>
						<p>Each organisation has an MCP endpoint and a REST API with scoped keys. Connect Claude or your own agent in one command, and decide what each key may do. Or let Prospector run the agents itself, through Claude, any OpenAI-compatible endpoint or a model you host, with free search from your own SearXNG. Each agent's card says whether it is ready, and why not.</p>
					</div>
					<div class="lp-agents">
						<div class="lp-agents-side">
							<div class="lp-term">
								<div class="lp-term-head"><span class="lp-label">Connect Claude Code</span></div>
								<div class="lp-term-body">
									<span><b>$ </b>claude mcp add --transport http prospector \</span>
									<span class="more">https://&lt;host&gt;/o/&lt;org&gt;/mcp \</span>
									<span class="more">--header <i>"Authorization: Bearer $PROSPECTOR_KEY"</i></span>
								</div>
							</div>
							@Shot("agents.webp", "1440", "765", "Agents: each of Prospector's agents on a card saying whether it is ready, with its model, search, tools and fallback", "is-violet")
						</div>
						<div class="lp-rules">
							<div>
								<h3 class="lp-tag is-green">A key can</h3>
								<ul>
									<li>Search companies and people, and read what's due and the tasks people wrote<code>read</code></li>
									<li>Add companies, facts and suggested contacts, each with a source URL<code>research:write</code></li>
									<li>Draft notes, emails and follow-ups, shown as the agent's<code>drafts:write</code></li>
									<li>Record an outcome, shown as the agent's in the history<code>outcomes:write</code></li>
									<li>Value deals, work a renewal or expansion through its stages, and say where answering an enquiry stands<code>pipeline:write</code></li>
									<li>Say where answering an enquiry stands, without deals<code>enquiries:triage</code></li>
									<li>Record subscriptions and work customers' onboarding<code>customers:write</code></li>
									<li>Email a reply to someone who wrote in<code>enquiries:reply</code></li>
									<li>Email a customer the link to their onboarding steps<code>customers:invite</code></li>
									<li>Send a campaign to everyone in conversation or at a customer, through your own mail server, each with an unsubscribe link<code>campaigns:send</code></li>
								</ul>
							</div>
							<div>
								<h3 class="lp-tag is-coral">No key can</h3>
								<ul>
									<li>Send mail without a scope that says so, or to anyone on your never-contact list or erased on request</li>
									<li>Change your organisation's settings or members, or make or revoke API keys. Only <code>agents:configure</code> can change Prospector's own agents</li>
									<li>See another organisation</li>
									<li>Add anyone on your never-contact list</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</section>
			<section class="lp-section" id="team">
				<div class="lp-wrap">
					<div class="lp-section-head">
						<p class="lp-label">Built for a small team</p>
						<h2>The details that keep a list clean.</h2>
					</div>
					<div class="lp-grid">
						<div class="lp-cell is-coral"><h3>A never-contact list that holds</h3><p>Domains, email addresses and LinkedIn profiles. It applies to agents, imports and edits alike.</p></div>
						<div class="lp-cell is-gold"><h3>Calls at a sensible hour</h3><p>Office hours come from the contact's phone number, so Zurich gets called when Zurich is at work.</p></div>
						<div class="lp-cell is-green"><h3>The full history</h3><p>Every company shows who did what and when, people and agents alike.</p></div>
						<div class="lp-cell is-violet"><h3>Several organisations, one login</h3><p>Each has its own prospects, wording, team and keys. None can see another's.</p></div>
						<div class="lp-cell is-coral"><h3>Bring your own files</h3><p>Import companies from CSV and drafts from markdown. Re-importing never clears a date or an edit made in the app.</p></div>
						<div class="lp-cell is-gold"><h3>Your data stays with you</h3><p>Prospector runs on your own server, on SQLite or Postgres. Nobody else holds your prospect list.</p></div>
					</div>
				</div>
			</section>
			<section class="lp-install" id="start">
				<div class="lp-wrap lp-install-grid">
					<div>
						<p class="lp-label">Get started</p>
						<h2>Set up in four commands.</h2>
						<p class="lp-lede">Prospector is one program for Linux or macOS. Download it, name your organisation, add yourself and start working the list.</p>
						<div class="lp-cta">
							<a class="lp-btn is-primary" href={ templ.SafeURL(repoURL + "/releases/latest") }>Download Prospector ↗</a>
							<a class="lp-btn" href={ templ.SafeURL(repoURL + "#readme") }>Read the docs ↗</a>
						</div>
					</div>
					<div class="lp-term">
						<div class="lp-term-head"><span class="lp-label">Terminal</span></div>
						<div class="lp-term-body">
							<span><b>$ </b>prospector org add acme <i>"Acme"</i></span>
							<span><b>$ </b>prospector user add you@example.com <i>"Your Name"</i></span>
							<span><b>$ </b>prospector member add acme you@example.com owner</span>
							<span><b>$ </b>prospector serve</span>
							<span class="note"># http://127.0.0.1:8766</span>
						</div>
					</div>
				</div>
			</section>
			if intake != "" {
				@EnquiryForm(intake, origin)
			}
			<footer class="lp-foot">
				<div class="lp-wrap">
					@Brand()
					<span>Prospecting for small teams with a named list.</span>
					<nav aria-label="Footer">
						<a href={ templ.SafeURL(repoURL) }>GitHub</a>
						<a href={ templ.SafeURL(repoURL + "/releases") }>Releases</a>
						<a href="/login">Sign in</a>
					</nav>
				</div>
			</footer>
		</body>
	</html>
}

// EnquiryForm stays hidden until its script runs, since without one it can't send, and
// the script shows it only on the origin the intake route will answer.
templ EnquiryForm(intake, origin string) {
	<section class="lp-contact" id="contact" hidden>
		<div class="lp-wrap lp-contact-grid">
			<div>
				<p class="lp-label">Contact</p>
				<h2>Ask us anything.</h2>
				<p class="lp-lede">A question, a demo, or help getting it running. Someone will write back to the address you give.</p>
			</div>
			<form class="lp-form" data-intake={ intake } data-origin={ origin }>
				<label>Your name<input name="name" autocomplete="name" maxlength="200"/></label>
				<label>Email<input name="email" type="email" autocomplete="email" maxlength="200" required/></label>
				<label>Company<input name="company" autocomplete="organization" maxlength="200"/></label>
				<label>
					What it's about
					<select name="kind">
						<option value="sales">A question</option>
						<option value="demo">See it running</option>
						<option value="support">Help running it</option>
						<option value="feature">Something it should do</option>
					</select>
				</label>
				<label class="is-wide">Message<textarea name="message" rows="5" maxlength="5000" required></textarea></label>
				<label class="lp-trap" aria-hidden="true">Leave this empty<input name="ref_note" tabindex="-1" autocomplete="off"/></label>
				<div class="lp-form-foot is-wide">
					<button class="lp-btn is-primary" type="submit">Send</button>
					<p class="lp-form-status" role="status"></p>
				</div>
			</form>
		</div>
	</section>
}
