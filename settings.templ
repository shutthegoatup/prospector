package main

import (
	"github.com/shutthegoatup/prospector/components/button"
	"strconv"
	"strings"
)

templ Section(title, hint string) {
	<section class="flex flex-col gap-4 panel p-6">
		<div>
			<h2 class="font-heading text-lg font-semibold">{ title }</h2>
			if hint != "" {
				<p class="mt-0.5 text-sm text-muted-foreground">{ hint }</p>
			}
		</div>
		{ children... }
	</section>
}

templ Row(label string) {
	<label class="grid grid-cols-1 items-start gap-1.5 sm:grid-cols-[170px_1fr] sm:gap-4">
		<span class="pt-2.5">@Label(label)</span>
		<span class="flex flex-col gap-1">{ children... }</span>
	</label>
}

const fieldClass = "h-10 rounded-lg border border-input bg-muted px-3 text-sm disabled:opacity-60"
const areaClass = "rounded-lg border border-input bg-muted px-3 py-2 text-sm leading-relaxed disabled:opacity-60"

templ SettingsView(q *Req, d SettingsData) {
	{{ set := q.Org.Settings.withDefaults() }}
	@PageHead("Settings") {
		<span class="text-sm text-muted-foreground">For <b class="text-foreground">{ q.Org.Name }</b> only</span>
	}
	<div class="flex max-w-3xl flex-col gap-5">
		<form data-form="ui/voice" data-refresh="true">
			@Section("Your voice", "Yours in this organisation: used in call scripts and added to copied emails.") {
				@Row("Caller name") {
					<input name="caller_name" value={ d.Me.CallerName } placeholder={ q.User.Name } class={ fieldClass }/>
				}
				@Row("Signature") {
					<textarea name="signature" rows="4" class={ areaClass }>{ d.Me.Signature }</textarea>
				}
				<div class="flex items-center gap-3">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Save
					}
					<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
				</div>
			}
		</form>
		if q.User.HasPassword() {
			<form data-form="/password" data-reset="true">
				@Section("Your password", "For your sign-in across every organisation. Changing it signs out your other sessions.") {
					@Row("Current") {
						<input name="current" type="password" required autocomplete="current-password" class={ fieldClass }/>
					}
					@Row("New") {
						<input name="new" type="password" required minlength="10" autocomplete="new-password" class={ fieldClass }/>
					}
					<div class="flex items-center gap-3">
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							Change
						}
						<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
					</div>
				}
			</form>
		} else {
			@Section("Your sign-in", "You sign in through a provider, so there is no password here to change. Whoever runs this server can give you one.")
		}
		<form data-form="ui/settings" data-refresh="true">
			@Section("Organisation", ownerHint(q)) {
				<fieldset disabled?={ !q.Owner() } class="flex flex-col gap-4">
					@Row("Name") {
						<input name="name" required value={ q.Org.Name } class={ fieldClass }/>
					}
					@Row("Colour") {
						<input name="color" type="color" value={ q.Org.Color } class="h-10 w-20 rounded-lg border border-input bg-muted"/>
					}
					@Row("Email after") {
						<span class="flex items-center gap-2 text-sm text-muted-foreground"><input name="email_after_days" type="number" min="0" max="60" value={ strconv.Itoa(set.EmailAfterDays) } class={ fieldClass + " w-24" }/> days without a LinkedIn accept</span>
					}
					@Row("Follow up after") {
						<span class="flex items-center gap-2 text-sm text-muted-foreground"><input name="followup_after_days" type="number" min="0" max="60" value={ strconv.Itoa(set.FollowupAfterDays) } class={ fieldClass + " w-24" }/> days without a reply</span>
					}
					@Row("Connection note") {
						<textarea name="note_template" rows="5" class={ areaClass }>{ set.NoteTemplate }</textarea>
						@Meta("{first} {company} {org} are filled in. LinkedIn allows 300 characters.")
					}
					@Row("What you do") {
						<textarea name="pitch" rows="3" class={ areaClass }>{ set.Pitch }</textarea>
						@Meta("The call script's pitch line. {company} is filled in.")
					}
					@Row("Never contact") {
						<textarea name="never_contact" rows="3" placeholder="domains, emails or LinkedIn links, one per line" class={ areaClass }>{ set.NeverContact }</textarea>
						@Meta(neverContactHint(d.Covered))
					}
					@Row("What you look for") {
						<textarea name="look_for" rows="4" placeholder={ "careers_page: a careers or jobs page on their site\nats: the applicant tracking system they use" } class={ areaClass }>{ set.LookFor }</textarea>
						@Meta("One per line, a name and what counts. Agents record each as a fact under that name, and Research shows which a company has.")
					}
					@Row("Agent guidance") {
						<textarea name="agent_guidance" rows="8" placeholder="Who you sell to, who's off-limits, how to judge fit" class={ areaClass }>{ set.AgentGuidance }</textarea>
						@Meta("Sent to every agent when it connects, after the built-in task guidance, and returned by the guidance tool.")
					}
					@Row("Enquiry form sites") {
						<textarea name="enquiry_sites" rows="2" placeholder="https://www.example.com" class={ areaClass }>{ set.EnquirySites }</textarea>
						@Meta("One per line. A form on these sites can POST an enquiry as JSON to " + d.Intake + " and it shows under Enquiries. Leave empty to accept none.")
					}
					@Row("Onboarding steps") {
						<textarea name="onboarding_steps" rows="6" placeholder={ "them: Name a project lead, 2 days\nthem: Send your product files, 7 days\nus: Kick-off call, 10 days\nus: Go live, 30 days" } class={ areaClass }>{ set.OnboardingSteps }</textarea>
						@Meta("What a new customer goes through, one step a line, in order. Start a line with them: or us: for who does it (us when left out), and end it with a number of days after the start when it is due. A customer counts as live once every step is done. Changing these leaves onboardings already running as they are.")
					}
					@Row("Currency") {
						<input name="currency" value={ set.Currency } maxlength="3" class={ fieldClass + " w-24" }/>
						@Meta("The three-letter code deals are valued in, such as GBP, EUR or USD. Changing it leaves the deals you already valued as they are.")
					}
					@Row("Cold email") {
						<span class="flex items-center gap-2.5 pt-2 text-sm"><input type="checkbox" name="incorporated_only" checked?={ set.IncorporatedOnly } class="size-4 accent-[var(--primary)]"/> Only email incorporated companies (UK PECR)</span>
					}
					<div class="flex items-center gap-3">
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							Save
						}
						<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
					</div>
				</fieldset>
			}
		</form>
		if q.Owner() {
			<form data-form="ui/mail" data-refresh="true">
				@Section("Outgoing mail", mailHint(d.Mail)) {
					@Row("Server") {
						<span class="flex items-center gap-2"><input name="host" value={ d.Mail.Host } placeholder="smtp.example.com" class={ fieldClass + " min-w-[200px] flex-1" }/><input name="port" type="number" min="1" max="65535" value={ strconv.Itoa(d.Mail.Port) } aria-label="Port" class={ fieldClass + " w-24" }/></span>
						@Meta("SMTP over TLS, on port 587, 465, 2525 or 25. Clear the server to stop using it.")
					}
					@Row("Username") {
						<input name="username" value={ d.Mail.Username } autocomplete="off" class={ fieldClass }/>
					}
					@Row("Password") {
						<input name="password" type="password" autocomplete="new-password" placeholder={ passwordHint(d.Mail) } class={ fieldClass }/>
						@Meta("Never shown again. Changing the server or username needs it entered again.")
					}
					@Row("From") {
						<input name="sender" value={ d.Mail.Sender } placeholder={ q.Org.Name + " <hello@example.com>" } class={ fieldClass }/>
					}
					<div class="flex items-center gap-3">
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							Save
						}
						<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
					</div>
				}
			</form>
			if d.Mail.Host != "" || d.Mail.SiteMail {
				<form data-form="ui/mail/test" class="flex items-center gap-3">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
						Send me a test email
					}
					<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
				</form>
			}
			@OwnAgents(d.Agents)
		}
		@Section("Sequence", "Every contact goes through these steps; the waits come from above.") {
			<ol class="flex max-w-lg flex-col gap-1 text-sm">
				<li class="flex items-center gap-2.5 rounded-lg border border-border bg-muted px-3 py-2.5"><span class="grid size-5 place-items-center rounded-full bg-secondary font-mono text-xs">1</span>LinkedIn connection request</li>
				<li class="pl-8 font-mono text-xs text-mark">{ "↓ on accept, or after " + plural(set.EmailAfterDays, "day") }</li>
				<li class="flex items-center gap-2.5 rounded-lg border border-border bg-muted px-3 py-2.5"><span class="grid size-5 place-items-center rounded-full bg-secondary font-mono text-xs">2</span>LinkedIn message if accepted, else email</li>
				<li class="pl-8 font-mono text-xs text-mark">{ "↓ " + plural(set.FollowupAfterDays, "day") + " without a reply" }</li>
				<li class="flex items-center gap-2.5 rounded-lg border border-border bg-muted px-3 py-2.5"><span class="grid size-5 place-items-center rounded-full bg-secondary font-mono text-xs">3</span>Follow-up email</li>
				<li class="pl-8 font-mono text-xs text-mark">↓ whenever a number is known, in office hours</li>
				<li class="flex items-center gap-2.5 rounded-lg border border-border bg-muted px-3 py-2.5"><span class="grid size-5 place-items-center rounded-full bg-secondary font-mono text-xs">4</span>Call</li>
			</ol>
		}
		if q.Owner() {
			@SSOSettings(q, d)
		}
		@Section("Team", "") {
			for _, m := range d.Members {
				<div class="flex flex-wrap justify-between border-b border-dashed border-border py-1.5 text-sm">
					<span><b>{ m.Name }</b> <span class="text-muted-foreground">{ m.Email }</span></span>
					<span class="flex items-center gap-3">
						@Meta(memberWork(m.Membership))
						if q.Owner() {
							@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "ui/member/role", "data-body": jsonBody("user_id", m.UserID, "role", otherRole(m.Role)), "data-confirm": roleConfirm(q, m)}}) {
								{ "Make " + otherRole(m.Role) }
							}
							@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "ui/member/remove", "data-body": jsonBody("user_id", m.UserID), "data-confirm": removeConfirm(q, m)}}) {
								Remove
							}
						}
					</span>
					if q.Owner() && m.Role != "owner" {
						<form data-form="ui/member/areas" data-refresh="true" class="flex w-full flex-wrap items-center gap-3 pt-1.5">
							<input type="hidden" name="user_id" value={ strconv.FormatInt(m.UserID, 10) } data-number="true"/>
							for _, ar := range Areas {
								<label class="flex items-center gap-1.5 text-xs text-muted-foreground" title={ ar.What }>
									<input type="checkbox" name="areas" value={ ar.Name } data-multi="true" checked?={ m.Works(ar.Name) } class="size-4 accent-[var(--primary)]"/>
									{ ar.Name }
								</label>
							}
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeXs, Variant: button.VariantOutline}) {
								Save
							}
							<p data-result class="text-xs text-[var(--ok)]" role="status"></p>
						</form>
					}
				</div>
			}
			if q.Owner() {
				<form data-form="ui/member" data-reset="true" class="flex flex-wrap gap-2">
					<label class="sr-only" for="m-email">Email</label>
					<input id="m-email" name="email" type="email" required placeholder="email" class={ fieldClass + " min-w-[200px] flex-1" }/>
					<label class="sr-only" for="m-name">Name</label>
					<input id="m-name" name="name" placeholder="name" class={ fieldClass + " w-40" }/>
					<label class="sr-only" for="m-role">Role</label>
					<select id="m-role" name="role" class={ fieldClass }><option value="member">member</option><option value="owner">owner</option></select>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline, Class: "h-10"}) {
						Add
					}
					<p data-result class="w-full select-all font-mono text-sm text-[var(--ok)]" role="status"></p>
				</form>
			}
		}
		if q.Owner() {
			@Section("Your data", "") {
				<p class="text-sm text-muted-foreground">Everything this organisation holds here, in one file: companies, people, facts, enquiries, history, settings and who has access. It holds no passwords, keys or sign-on secrets.</p>
				<div>
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-download": "ui/export-org", "data-file": q.Org.Slug + ".json"}}) {
						Download everything
					}
				</div>
			}
		}
	</div>
}

func memberWork(m Membership) string {
	if m.Role == "owner" {
		return "owner"
	}
	if m.Areas == "" {
		return "member · reads only"
	}
	return "member · " + strings.ReplaceAll(m.Areas, " ", ", ")
}

func otherRole(role string) string {
	if role == "owner" {
		return "member"
	}
	return "owner"
}

func roleConfirm(q *Req, m Member) string {
	if m.Role != "owner" {
		return "Make " + m.Email + " an owner of " + q.Org.Name + "? They can change settings, keys and the team, export and erase."
	}
	if m.UserID == q.User.ID {
		return "Stop being an owner of " + q.Org.Name + "? Only another owner can make you one again."
	}
	return "Make " + m.Email + " a member? They stop being able to change settings, keys and the team."
}

func removeConfirm(q *Req, m Member) string {
	if m.UserID == q.User.ID {
		return "Leave " + q.Org.Name + "? You lose access to it."
	}
	return "Remove " + m.Email + " from " + q.Org.Name + "? They lose access to it; their account and what they added stay, and so do any API keys they made."
}

// neverContactHint names who the list is holding back, so an entry that catches the
// wrong people is noticed.
func neverContactHint(covered []string) string {
	hint := "One per line: a domain, an email address or a LinkedIn profile link. Applied to everything people and agents add, and to who comes up for outreach on Today."
	if len(covered) == 0 {
		return hint
	}
	shown := covered[:min(len(covered), 8)]
	hint += " It currently keeps " + plural(len(covered), "person") + " already here out of the queue: " + strings.Join(shown, ", ")
	if more := len(covered) - len(shown); more > 0 {
		hint += " and " + strconv.Itoa(more) + " more"
	}
	return hint + "."
}

func mailHint(m MailView) string {
	hint := "This organisation's own mail server. Invitations to new members leave through it"
	switch {
	case m.Host != "":
		return hint + "."
	case m.SiteMail:
		return hint + "; without one, they come from this site's address."
	}
	return hint + "; without one, a new member's first password is shown to you instead."
}

func passwordHint(m MailView) string {
	if m.HasPassword {
		return "saved: leave empty to keep it"
	}
	return ""
}


templ OwnAgents(v OwnAgentsView) {
	@Section("Prospector's agents", "Models Prospector calls itself to work tasks, each through its own OpenAI-compatible endpoint, with tools from an MCP server: Claude, ChatGPT and open models side by side. Several can work one task at once, each on its own request. What they find waits in Research like any agent's.") {
		if !v.Sealing {
			<p class="text-sm text-[var(--stop)]" role="alert">This server has no secret key, so it can't keep an API key: whoever runs it needs to set PROSPECTOR_SECRET_KEYS first.</p>
		}
		for _, agent := range v.Agents {
			@AgentForm(agent)
		}
		<details class="rounded-lg border border-dashed border-border p-3" open?={ len(v.Agents) == 0 }>
			<summary class="cursor-pointer text-sm font-medium">Add an agent</summary>
			@AgentForm(v.New)
		</details>
	}
}

// agentPath and agentMethod are where an agent's form goes in the API.
func agentPath(v AgentView) string {
	if v.ID == 0 {
		return "api/v1/agents"
	}
	return "api/v1/agents/" + strconv.FormatInt(v.ID, 10)
}

func agentMethod(v AgentView) string {
	if v.ID == 0 {
		return "POST"
	}
	return "PUT"
}

func agentFallbackMinutes(v AgentView) int {
	if v.FallbackMinutes == 0 {
		return 15
	}
	return v.FallbackMinutes
}

func agentModelsID(v AgentView) string {
	if v.ID == 0 {
		return "agent-models-new"
	}
	return "agent-models-" + strconv.FormatInt(v.ID, 10)
}

templ AgentForm(v AgentView) {
	<form data-form={ agentPath(v) } data-method={ agentMethod(v) } data-refresh="true" class="flex flex-col gap-3 border-b border-dashed border-border py-3 last:border-0">
		@Row("Name") {
			<input name="name" value={ v.Name } placeholder="Claude, ChatGPT, the gateway…" autocomplete="off" class={ fieldClass }/>
			@Meta("What it is called on the task page and in the record.")
		}
		@Row("Kind") {
			<select name="kind" class={ fieldClass }>
				for _, k := range AgentKinds {
					<option value={ k.Key } selected?={ k.Key == v.Kind || (v.Kind == "" && k.Key == kindOpenAI) }>{ k.Label }</option>
				}
			</select>
			@Meta("Anthropic reaches Claude through Anthropic's own API with its official SDK; OpenAI-compatible is ChatGPT, OpenRouter, a gateway of your own or any open model behind one.")
		}
		@Row("Endpoint") {
			<input name="base_url" value={ v.BaseURL } placeholder="https://openrouter.ai/api/v1" autocomplete="off" class={ fieldClass }/>
			@Meta("For OpenAI-compatible, the address its /models and /chat/completions are under, such as https://api.openai.com/v1. For Anthropic, leave it empty for Anthropic's own.")
		}
		@Row("API key") {
			<input name="api_key" type="password" autocomplete="new-password" placeholder={ agentKeyHint(v) } class={ fieldClass }/>
			@Meta("Never shown again. Changing the endpoint needs it entered again.")
		}
		@Row("Model") {
			<input name="model" value={ v.Model } list={ agentModelsID(v) } autocomplete="off" placeholder="one the endpoint lists" class={ fieldClass }/>
			<datalist id={ agentModelsID(v) }>
				for _, m := range v.ModelList() {
					<option value={ m }></option>
				}
			</datalist>
			@Meta(agentModelHint(v))
		}
		@Row("Search") {
			<input name="search_url" value={ v.SearchURL } placeholder="https://searx.example.com" autocomplete="off" class={ fieldClass }/>
			@Meta("A SearXNG instance you run: free, open-source search, with json among its search.formats. The agent searches through it, and reads pages itself, with no paid search service.")
		}
		@Row("Tools") {
			<input name="tools_url" value={ v.ToolsURL } placeholder="https://mcp.example.com/mcp" autocomplete="off" class={ fieldClass }/>
			@Meta("An MCP server, such as a gateway's federated /mcp. It's sent the endpoint's key only when it's on the same address.")
		}
		if len(v.Others) > 0 {
			@Row("Fallback") {
				<div class="flex flex-wrap items-center gap-2">
					<select name="fallback" data-number="true" class={ fieldClass }>
						<option value="0">None: wait however long it takes</option>
						for _, o := range v.Others {
							<option value={ strconv.FormatInt(o.ID, 10) } selected?={ o.ID == v.FallbackID }>{ o.Name }</option>
						}
					</select>
					<span class="text-sm text-muted-foreground">after</span>
					<input type="number" name="fallback_minutes" min="1" value={ strconv.Itoa(agentFallbackMinutes(v)) } class={ fieldClass }/>
					<span class="text-sm text-muted-foreground">minutes</span>
				</div>
				@Meta("When its endpoint stays limited or away this long, the agent hands its task to the one chosen here, which carries on from the task's notes.")
			}
		}
		if tools := v.ToolList(); len(tools) > 0 {
			@Row("Allowed tools") {
				<div class="flex flex-col gap-1.5 pt-1.5">
					for _, t := range tools {
						<label class="flex items-start gap-2.5 text-sm">
							<input type="checkbox" name="tools" value={ t.Name } data-multi="true" checked?={ v.Allows(t.Name) } class="mt-0.5 size-4 accent-[var(--primary)]"/>
							<span><span class="font-mono text-xs">{ t.Name }</span> <span class="text-muted-foreground">{ t.Description }</span></span>
						</label>
					}
				</div>
				@Meta("The agent uses only the tools ticked here. LinkedIn's terms forbid automated access, logged-in browsers included: prefer search and fetch tools to browser and captcha ones.")
			}
		}
		if v.Problem != "" {
			<p class="text-sm text-[var(--stop)]" role="alert">{ "Last check: " + v.Problem }</p>
		}
		<div class="flex flex-wrap items-center gap-3">
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
				if v.ID == 0 {
					Add and check
				} else {
					Save and check
				}
			}
			if v.ID != 0 {
				@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": agentPath(v), "data-method": "DELETE",
					"data-confirm": "Delete " + v.Name + "? Its runs stop and its key is revoked; what it found stays."}}) {
					Delete
				}
			}
			<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
		</div>
	</form>
}

func agentKeyHint(v AgentView) string {
	if v.HasKey {
		return "saved: leave empty to keep it"
	}
	return ""
}

func agentModelHint(v AgentView) string {
	if n := len(v.ModelList()); n > 0 {
		return "The endpoint lists " + plural(n, "model") + "; a router model that picks one per request works too."
	}
	return "Saving fetches the endpoint's list to choose from."
}

func ownerHint(q *Req) string {
	if q.Owner() {
		return "Shared by everyone in this organisation."
	}
	return "Only an owner can change these."
}
