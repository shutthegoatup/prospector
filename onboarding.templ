package main

import (
	"github.com/shutthegoatup/prospector/components/button"
	"github.com/shutthegoatup/prospector/components/input"
	"strconv"
)

func onboardingStanding(r OnboardingRow) (string, string) {
	switch {
	case r.Live():
		return "live since " + r.LiveOn, "ok"
	case r.Late > 0:
		return plural(r.Late, "step") + " late", "stop"
	case r.DueToday > 0:
		return plural(r.DueToday, "step") + " due today", "warn"
	}
	return "on track", "agent"
}

func whoLabel(who string) string {
	if who == StepTheirs {
		return "them"
	}
	return "us"
}

func stepMeta(st OnboardingStep, day string) string {
	switch {
	case st.DoneOn != nil:
		return joinNonEmpty(" · ", "done "+*st.DoneOn, actorLabel(st.DoneBy))
	case st.Due != nil && *st.Due < day:
		return "late, was due " + *st.Due
	case st.Due != nil:
		return "due " + *st.Due
	}
	return "no date"
}

templ OnboardingView(q *Req, rows []OnboardingRow, planned int, day string) {
	@PageHead("Onboarding")
	<p class="mb-5 max-w-[70ch] text-sm text-muted-foreground">The steps between a signature and a live customer. Each onboarding is a copy of your steps, made the day it starts, so changing them in Settings later leaves the ones running as they are. Start one from a company's page. Ones running late come first.</p>
	@Whose(areaSupport, "Onboarding is")
	if planned == 0 {
		@Empty("No steps written yet", "An owner writes the steps under Settings, one a line. Then start an onboarding from a company's page.")
	} else if len(rows) == 0 {
		@Empty("Nobody is being onboarded", "Open a company and start one.")
	}
	<div class="flex max-w-3xl flex-col gap-3">
		for _, r := range rows {
			@OnboardingCard(q, r, day, true)
		}
	</div>
}

// OnboardingCard is one onboarding with its steps and the buttons that tick them off.
templ OnboardingCard(q *Req, r OnboardingRow, day string, named bool) {
	{{ text, state := onboardingStanding(r) }}
	<article class="flex flex-col gap-2.5 rounded-xl border border-border bg-card p-3.5 text-sm" data-onboarding={ strconv.FormatInt(r.ID, 10) }>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<span>
				if named {
					<a href={ templ.SafeURL(q.Base() + "companies/" + strconv.FormatInt(r.CompanyID, 10)) } class="font-bold text-foreground hover:text-mark">{ r.Company }</a>
				}
				if r.Name != "" {
					<span class="text-muted-foreground">{ prefixedIf(named, " · ") + r.Name }</span>
				}
				<span class="block font-mono text-xs text-muted-foreground">{ strconv.Itoa(r.Done) + " of " + strconv.Itoa(len(r.Steps)) + " · started " + r.Start }</span>
			</span>
			@Pill(text, state)
		</div>
		<div>
			for _, st := range r.Steps {
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-dashed border-border py-2">
					<span class="min-w-0">
						<span class="font-mono text-xs text-muted-foreground">{ strconv.Itoa(st.Seq) + " · " + whoLabel(st.Who) + " · " }</span>
						if st.DoneOn != nil {
							<span class="text-muted-foreground">{ st.Name }</span>
						} else {
							<b>{ st.Name }</b>
						}
						<span class="block font-mono text-xs text-muted-foreground">{ stepMeta(st, day) }</span>
					</span>
					<span class="flex items-center gap-2">
						if canDo(ctx, areaSupport) && st.DoneOn == nil {
							@input.Input(input.Props{Type: "date", Value: deref(st.Due), Class: "h-8 w-44 bg-muted",
								Attributes: templ.Attributes{"data-field": "due", "data-step": strconv.FormatInt(st.ID, 10), "data-refresh": "true", "aria-label": "Due"}})
							@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-post": "api/v1/onboarding-steps/" + strconv.FormatInt(st.ID, 10), "data-method": "PATCH", "data-body": `{"done":true}`}}) {
								Done
							}
						} else if canDo(ctx, areaSupport) {
							@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/onboarding-steps/" + strconv.FormatInt(st.ID, 10), "data-method": "PATCH", "data-body": `{"done":false}`}}) {
								Not done
							}
						}
					</span>
				</div>
			}
		</div>
		<div class="flex flex-col gap-2 border-t border-border pt-2">
			@Label("Their page")
			@Meta("Someone you invite is emailed a link to a page showing the steps that are theirs, which they can mark done, and nothing else. It needs no password and opens in one browser at a time.")
			for _, inv := range r.Invites {
				<div class="flex flex-wrap items-center justify-between gap-2">
					<span>
						<b>{ inv.Name }</b>
						<span class="font-mono text-xs text-muted-foreground">{ " " + inv.Email }</span>
					</span>
					if inv.RevokedAt != nil {
						@Pill("withdrawn", "")
					} else {
						<span class="flex items-center gap-2">
							@Pill("can open it", "ok")
							if canDo(ctx, areaSupport) {
								@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/onboarding-invites/" + strconv.FormatInt(inv.ID, 10), "data-method": "DELETE", "data-confirm": "Withdraw " + inv.Name + "'s access? Their page closes in every browser at once."}}) {
									Withdraw
								}
							}
						</span>
					}
				</div>
			}
			if !canDo(ctx, areaSupport) {
				if len(r.Invites) == 0 {
					@Meta("Nobody has been invited yet.")
				}
			} else if !r.MailOn {
				@Meta("To invite anyone, an owner sets a mail server in Settings and the server needs its public address (PROSPECTOR_URL).")
			} else if len(r.Invitable) == 0 {
				@Meta("Nobody at this company has an email address here to send a link to.")
			} else {
				<form data-form={ "api/v1/onboardings/" + strconv.FormatInt(r.ID, 10) + "/invites" } data-refresh="true" class="flex flex-wrap items-center gap-2">
					<select name="contact" data-number="true" aria-label="Who to invite" class="h-9 rounded-lg border border-input bg-muted px-2 text-sm">
						for _, p := range r.Invitable {
							<option value={ strconv.FormatInt(p.ID, 10) }>{ displayName(p) + " · " + deref(p.Email) }</option>
						}
					</select>
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Type: button.TypeSubmit}) {
						Email them a link
					}
					<span class="font-mono text-xs text-muted-foreground" data-result></span>
				</form>
			}
		</div>
		if canDo(ctx, areaSupport) {
			<div class="flex justify-end">
				@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "api/v1/onboardings/" + strconv.FormatInt(r.ID, 10), "data-method": "DELETE", "data-confirm": "Remove this onboarding and its steps? Use this for one started by mistake."}}) {
					Remove
				}
			</div>
		}
	</article>
}

// OnboardingStart starts an onboarding for a company from the organisation's steps.
templ OnboardingStart(company int64, day string) {
	<form data-form="api/v1/onboardings" data-refresh="true" data-reset="true" class="mt-2 flex flex-wrap items-start gap-2">
		<input type="number" name="company" value={ strconv.FormatInt(company, 10) } hidden/>
		<label class="flex min-w-[220px] flex-1 flex-col gap-1">
			@Label("For, if they have several")
			<input name="name" placeholder="e.g. the Leith site" class="h-9 rounded-lg border border-input bg-muted px-3 text-sm"/>
		</label>
		<label class="flex flex-col gap-1">
			@Label("Starts")
			<input name="start" type="date" required value={ day } class="h-9 rounded-lg border border-input bg-muted px-3 text-sm"/>
		</label>
		<span class="flex flex-col gap-1">
			@Label("From your steps")
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "h-9"}) {
				Start
			}
		</span>
		<span class="font-mono text-xs text-muted-foreground" data-result></span>
	</form>
}
