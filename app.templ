package main

import "strconv"

// ReactMount is where a React page draws itself; what it may do comes from the API, and
// what the viewer may change from these attributes, which only decide what is offered.
templ ReactMount(q *Req) {
	<div id="app" data-org={ q.Org.Slug } data-sales={ strconv.FormatBool(canDo(ctx, areaSales)) } data-support={ strconv.FormatBool(canDo(ctx, areaSupport)) } data-owner={ strconv.FormatBool(q.Owner()) } data-no-refresh="true"></div>
	<script type="module" src={ "/assets/app/main.js?v=" + assetVersion }></script>
}
