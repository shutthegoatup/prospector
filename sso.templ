package main

import "github.com/shutthegoatup/prospector/components/button"

templ SSOSettings(q *Req, d SettingsData) {
	@Section("Single sign-on", "Let people at your company's email domains sign in through your own provider: Okta, Entra ID, Google Workspace or anything else that speaks OpenID Connect.") {
		if d.Callback == "" {
			@Meta("Set PROSPECTOR_URL to this app's address first: it is where the provider sends people back.")
		} else if !d.Sealing && !d.SSO.On() {
			@Meta("Set PROSPECTOR_SECRET_KEYS first: the provider's client secret is kept sealed under it. `prospector secret-key` makes a key.")
		} else {
			<div class="flex flex-col gap-2">
				@Label("Your domains")
				for _, dom := range d.SSO.Domains {
					<div class="flex flex-wrap items-center justify-between gap-2 border-b border-dashed border-border py-1.5 text-sm">
						<span class="flex items-center gap-2">
							<b>{ dom.Domain }</b>
							if dom.VerifiedAt != nil {
								@Pill("verified", "ok")
							} else {
								@Pill("not verified", "warn")
							}
						</span>
						<span class="flex items-center gap-3">
							if dom.VerifiedAt == nil {
								@button.Button(button.Props{Size: button.SizeXs, Attributes: templ.Attributes{"data-post": "ui/sso/verify", "data-body": jsonBody("domain", dom.Domain)}}) {
									Verify
								}
							}
							@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "ui/sso/domain/remove", "data-body": jsonBody("domain", dom.Domain), "data-confirm": "Remove " + dom.Domain + "? People at it can no longer use single sign-on here."}}) {
								Remove
							}
						</span>
						if dom.VerifiedAt == nil {
							<p class="w-full text-muted-foreground">Add a TXT record named <code class="select-all break-all font-mono text-xs text-foreground">{ dom.Record() }</code> with the value <code class="select-all break-all font-mono text-xs text-foreground">{ dom.Token }</code>, then verify.</p>
						}
					</div>
				}
				<form data-form="ui/sso/domain" data-reset="true" data-refresh="true" class="flex flex-wrap gap-2">
					<label class="sr-only" for="sso-domain">Email domain</label>
					<input id="sso-domain" name="domain" required placeholder="example.com" class={ fieldClass + " min-w-[200px] flex-1" }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline, Class: "h-10"}) {
						Add domain
					}
					<p data-result class="w-full text-sm text-[var(--ok)]" role="status"></p>
				</form>
				@Meta("Single sign-on only ever speaks for addresses at a verified domain, matched whole: example.com doesn't cover mail.example.com.")
			</div>
			<form data-form="ui/sso" data-refresh="true" class="flex flex-col gap-4">
				@Row("Issuer") {
					<input name="issuer" type="url" value={ d.SSO.Issuer } placeholder="https://login.example.com" class={ fieldClass }/>
					@Meta("Your provider's OpenID Connect issuer. Empty turns single sign-on off.")
				}
				@Row("Client ID") {
					<input name="client_id" value={ d.SSO.ClientID } autocomplete="off" class={ fieldClass }/>
				}
				@Row("Client secret") {
					<input name="client_secret" type="password" autocomplete="new-password" placeholder={ secretHint(d.SSO) } class={ fieldClass }/>
					if !d.Sealing {
						@Meta("A new secret can't be kept until PROSPECTOR_SECRET_KEYS is set; everything else here can still be changed.")
					}
				}
				@Row("Redirect URI") {
					<code class="select-all break-all pt-2 font-mono text-xs">{ d.Callback }</code>
					@Meta("Register this with your provider as the place to send people back.")
				}
				@Row("Require it") {
					<span class="flex items-center gap-2.5 pt-2 text-sm"><input type="checkbox" name="required" checked?={ d.SSO.Required } class="size-4 accent-[var(--primary)]"/> Members at your domains must sign in this way</span>
					@Meta("Owners can still use a password, so a broken provider can be put right. API keys are not affected.")
				}
				@Row("New people") {
					<span class="flex items-center gap-2.5 pt-2 text-sm"><input type="checkbox" name="auto_join" checked?={ d.SSO.AutoJoin } class="size-4 accent-[var(--primary)]"/> Anyone at your domains becomes a member when they first sign in</span>
					@Meta("Never an owner. Someone you remove here joins again while your provider still lets them in: remove them there too.")
				}
				<div class="flex items-center gap-3">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Save
					}
					<p data-result class="text-sm text-[var(--ok)]" role="status"></p>
				</div>
			</form>
		}
	}
}

func secretHint(c *SSO) string {
	if c.ClientSecret != "" {
		return "Kept. Type a new one to replace it"
	}
	return ""
}
