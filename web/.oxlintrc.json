{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/immutability": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/globals": "error",
    "react/preserve-manual-memoization": "error",
    "react/set-state-in-effect": "warn",
    "react/only-export-components": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/label-has-associated-control": ["error", { "controlComponents": ["Input", "Textarea", "Checkbox", "Field", "Choice"], "depth": 4 }],
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/jsx-no-literals": "error"
  },
  "overrides": [
    {
      "files": [
        "src/components/app/index.tsx",
        "src/components/app/layout.tsx",
        "src/components/app/more.tsx",
        "src/components/app/site.tsx",
        "src/components/app/subscription.tsx",
        "src/pages/Add.tsx",
        "src/pages/Agents.tsx",
        "src/pages/Campaigns.tsx",
        "src/pages/Companies.tsx",
        "src/pages/Company.tsx",
        "src/pages/Conversations.tsx",
        "src/pages/Enquiries.tsx",
        "src/pages/Onboarding.tsx",
        "src/pages/Prepare.tsx",
        "src/pages/Research.tsx",
        "src/pages/Served.tsx",
        "src/pages/Settings.tsx",
        "src/pages/SignIn.tsx",
        "src/pages/Subscriptions.tsx",
        "src/pages/Tasks.tsx",
        "src/pages/Task.tsx",
        "src/pages/Today.tsx",
        "src/site/ApiReference.tsx",
        "src/site/Landing.tsx"
      ],
      "rules": { "react/jsx-no-literals": "off" }
    }
  ],
  "ignorePatterns": ["src/api.d.ts", "src/components/ui/**", "site-build/**"]
}
