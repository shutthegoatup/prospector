{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/immutability": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/globals": "error",
    "react/preserve-manual-memoization": "error",
    "react/set-state-in-effect": "warn",
    "react/only-export-components": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/label-has-associated-control": ["error", { "controlComponents": ["Input", "Textarea", "Checkbox", "Field", "Choice"], "depth": 4 }],
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": ["src/api.d.ts", "src/components/ui/**", "site-build/**"]
}
