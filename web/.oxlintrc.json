{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/immutability": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/globals": "error",
    "react/preserve-manual-memoization": "error",
    "react/set-state-in-effect": "warn",
    "react/only-export-components": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/label-has-associated-control": ["error", { "controlComponents": ["Input", "Textarea", "Checkbox", "Field", "Choice"], "depth": 4 }],
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-tabindex": ["error", { "roles": ["tabpanel", "region"] }],
    "formatjs/enforce-id": ["error", { "idInterpolationPattern": "[sha512:contenthash:base64:6]" }],
    "formatjs/enforce-description": ["error", "literal"],
    "formatjs/enforce-default-message": ["error", "literal"],
    "formatjs/enforce-placeholders": "error",
    "formatjs/no-invalid-icu": "error",
    "formatjs/enforce-plural-rules": ["error", { "one": true, "other": true }],
    "formatjs/prefer-pound-in-plural": "error",
    "formatjs/no-literal-string-in-jsx": [
      "error",
      {
        "props": {
          "include": [
            ["*", "aria-{label,description,details,errormessage}"],
            ["*", "{title,label,hint,placeholder,alt,note,cta,button,blurb,work,audience,none}"]
          ]
        }
      }
    ]
  },
  "jsPlugins": ["eslint-plugin-formatjs"],
  "overrides": [
    {
      "files": [
        "src/components/app/site.tsx",
        "src/components/app/subscription.tsx",
        "src/pages/Agents.tsx",
        "src/pages/Campaigns.tsx",
        "src/pages/Conversations.tsx",
        "src/pages/Enquiries.tsx",
        "src/pages/Onboarding.tsx",
        "src/pages/Prepare.tsx",
        "src/pages/Settings.tsx",
        "src/pages/Subscriptions.tsx",
        "src/pages/Tasks.tsx",
        "src/pages/Task.tsx",
        "src/site/ApiReference.tsx",
        "src/site/Landing.tsx"
      ],
      "rules": { "formatjs/no-literal-string-in-jsx": "off" }
    }
  ],
  "ignorePatterns": ["src/api.d.ts", "src/components/ui/**", "site-build/**"]
}
