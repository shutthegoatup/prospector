{
  "name": "prospector-web",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "openapi-typescript ../api/openapi.yaml -o src/api.d.ts",
    "check": "tsc --noEmit",
    "i18n": "node i18n.mjs",
    "build": "npm run types && npm run i18n && npm run check && npm test && node build.mjs && vite build && vite build -c vite.form.config.ts && vite build -c vite.site.config.ts && node prerender.mjs",
    "test": "node --test src/*.test.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "a11y": "playwright test",
    "lint:api": "spectral lint ../api/openapi.yaml --ruleset ../api/.spectral.yaml"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.82.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.6",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@formatjs/cli": "6.16.36",
    "@playwright/test": "1.65.1",
    "@stoplight/spectral-cli": "6.17.1",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint-plugin-formatjs": "8.1.4",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "5.9.3",
    "vite": "8.4.0"
  }
}
