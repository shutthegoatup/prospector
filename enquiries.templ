package main

import (
	"github.com/shutthegoatup/prospector/components/button"
	"github.com/shutthegoatup/prospector/components/input"
	"github.com/shutthegoatup/prospector/components/nativeselect"
	"strconv"
)

func enquiryField(e Enquiry, field, label string) templ.Attributes {
	return templ.Attributes{"data-field": field, "data-enquiry": strconv.FormatInt(e.ID, 10), "data-refresh": "true", "aria-label": label}
}

func enquiryState(kind string) string {
	switch kind {
	case "sales", "demo", "signup":
		return "ok"
	case "support":
		return "warn"
	case "feature":
		return "agent"
	}
	return ""
}

func enquiryFrom(e Enquiry) string {
	from := joinNonEmpty(" · ", e.Site, e.Phone)
	if e.Via != "form" {
		from = joinNonEmpty(" · ", actorLabel(e.Via), from)
	}
	return joinNonEmpty(" · ", e.CreatedAt.Format("2 Jan 2006 15:04"), from)
}

templ EnquiriesView(q *Req, d EnquiriesData) {
	@PageHead("Enquiries")
	<p class="mb-5 max-w-[70ch] text-sm text-muted-foreground">What people sent through your sites' forms and your products, newest first. The words are theirs, exactly as sent. Each new one waits to be answered: give it an owner, and say when you're waiting on them or it's closed. Reply from here and it is emailed to them; their answer comes to your own mailbox, and you record it here.</p>
	<div class="mb-5 flex flex-wrap gap-2">
		for _, st := range EnquiryStates {
			if st.Key != EnquiryClosed && d.Counts["state:"+st.Key] > 0 {
				@Chip(q.Base()+"enquiries?state="+st.Key, st.Label, d.Counts["state:"+st.Key], d.Filter.State == st.Key)
			}
		}
		@Chip(q.Base()+"enquiries", "All", d.Counts[""], d.Filter.Kind == "" && d.Filter.State == "" && !d.Filter.Spam)
		for _, k := range EnquiryKinds {
			if d.Counts[k.Key] > 0 {
				@Chip(q.Base()+"enquiries?kind="+k.Key, k.Label, d.Counts[k.Key], d.Filter.Kind == k.Key && !d.Filter.Spam)
			}
		}
		if d.Counts["spam"] > 0 {
			@Chip(q.Base()+"enquiries?spam=1", "Spam", d.Counts["spam"], d.Filter.Spam)
		}
	</div>
	if len(d.Rows) == 0 {
		@Empty("Nothing yet", "Enquiries appear here once a site listed in Settings posts one, or a key with the enquiries:write scope does.")
	}
	<div class="flex max-w-3xl flex-col gap-3">
		for _, e := range d.Rows {
			<article class="flex flex-col gap-2.5 rounded-xl border border-border bg-card p-3.5 text-sm">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<span>
						<b>{ e.Name }</b>
						<a href={ templ.SafeURL("mailto:" + e.Email) } class="text-muted-foreground underline">{ e.Email }</a>
						if e.Company != "" {
							<span class="text-muted-foreground">{ " · " + e.Company }</span>
						}
					</span>
					<span class="flex items-center gap-2">
						if e.State == EnquiryOpen {
							@Pill(enquiryStateLabel(e.State), "warn")
						} else if e.State != "" {
							@Pill(enquiryStateLabel(e.State), "")
						}
						@Pill(kindLabel(e.Kind), enquiryState(e.Kind))
					</span>
				</div>
				if e.Message != "" {
					@Quote(e.Message)
				}
				<div class="flex flex-wrap items-center justify-between gap-2">
					@Meta(enquiryFrom(e))
					if e.CompanyID != nil {
						<a href={ templ.SafeURL(q.Base() + "companies/" + strconv.FormatInt(*e.CompanyID, 10)) } class="font-mono text-xs text-mark underline">{ d.Companies[*e.CompanyID] }</a>
					}
				</div>
				if !e.Spam {
					<div class="flex flex-wrap items-center gap-2 border-t border-border pt-2">
						@Label("Answering")
						@nativeselect.NativeSelect(nativeselect.Props{Size: nativeselect.SizeSm, Attributes: enquiryField(e, "state", "Where answering it stands")}) {
							if e.State == "" {
								@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: true}) {
									Not tracked
								}
							}
							for _, st := range EnquiryStates {
								@nativeselect.Option(nativeselect.OptionProps{Value: st.Key, Selected: st.Key == e.State}) {
									{ st.Label }
								}
							}
						}
						@nativeselect.NativeSelect(nativeselect.Props{Size: nativeselect.SizeSm, Attributes: enquiryField(e, "owner", "Who is answering it")}) {
							@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: e.Owner == ""}) {
								Nobody yet
							}
							if ownerLeft(Deal{Owner: e.Owner}, d.Members) {
								@nativeselect.Option(nativeselect.OptionProps{Value: e.Owner, Selected: true}) {
									{ e.Owner + " (left)" }
								}
							}
							for _, m := range d.Members {
								@nativeselect.Option(nativeselect.OptionProps{Value: m.Name, Selected: m.Name == e.Owner}) {
									{ m.Name }
								}
							}
						}
						@input.Input(input.Props{Value: e.Note, Placeholder: "Our note: not emailed, but theirs to see if they ask", Class: "h-8 min-w-[220px] flex-1 bg-muted", Attributes: enquiryField(e, "note", "Our note")})
					</div>
				}
				<div class="flex flex-wrap items-center justify-between gap-2">
					@Meta(e.Page)
					if !e.Spam {
						if e.ContactID != nil && d.Talking[*e.ContactID] {
							<a href={ templ.SafeURL(q.Base() + "conversations") } class="font-mono text-xs text-mark underline">In Conversations</a>
						} else {
							@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "ui/enquiry/converse", "data-body": jsonBody("id", e.ID)}}) {
								Start a conversation
							}
						}
					}
					if q.Owner() {
						@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-post": "ui/enquiry/delete", "data-body": jsonBody("id", e.ID), "data-confirm": "Delete this enquiry from " + e.Email + " for good?"}}) {
							Delete
						}
					}
				</div>
				if !e.Spam {
					@EnquiryThreadView(e, d.Threads[e.ID], d.MailOn)
				}
			</article>
		}
	</div>
	@Pager(d.Page, func(n int) string {
		return pageLink(q.Base()+"enquiries", n, "kind", d.Filter.Kind, "state", d.Filter.State, "spam", enquirySpamParam(d.Filter))
	})
}

func threadMeta(m EnquiryMessage) string {
	if m.Ours {
		return actorLabel(m.By) + " replied · " + m.CreatedAt.Format("2 Jan 15:04")
	}
	return "they said · recorded by " + actorLabel(m.By) + " · " + m.CreatedAt.Format("2 Jan 15:04")
}

// EnquiryThreadView is what has been said since an enquiry arrived, and the two ways to
// add to it: a reply that is emailed, and their answer, pasted in from wherever it came.
templ EnquiryThreadView(e Enquiry, thread []EnquiryMessage, mailOn bool) {
	<div class="flex flex-col gap-2 border-t border-border pt-3">
		for _, m := range thread {
			<div class="rounded-lg bg-muted p-3">
				@Meta(threadMeta(m))
				<p class="mt-1 whitespace-pre-wrap text-sm">{ m.Text }</p>
			</div>
		}
		<details>
			<summary class="cursor-pointer font-mono text-xs text-muted-foreground">Reply, or record their answer</summary>
			<div class="mt-2 flex flex-col gap-3">
				if mailOn {
					<form data-form={ "api/v1/enquiries/" + strconv.FormatInt(e.ID, 10) + "/replies" } data-reset="true" data-refresh="true" class="flex flex-col gap-2">
						<textarea name="text" rows="4" required maxlength="10000" placeholder={ "Your reply to " + e.Email + ". Only what you write here is sent; their answer comes to your own mailbox." } class="rounded-lg border border-input bg-muted px-3 py-2 text-sm leading-relaxed"></textarea>
						<div class="flex items-center gap-3">
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								Email this reply
							}
							<span data-result class="font-mono text-xs text-muted-foreground"></span>
						</div>
					</form>
				} else {
					@Meta("To reply from here an owner sets a mail server in Settings. Until then, answer from your own mail.")
				}
				<form data-form={ "api/v1/enquiries/" + strconv.FormatInt(e.ID, 10) + "/answers" } data-reset="true" data-refresh="true" class="flex flex-col gap-2">
					<textarea name="text" rows="3" required maxlength="10000" placeholder="What they said back, pasted from your mail. Nothing is sent." class="rounded-lg border border-input bg-muted px-3 py-2 text-sm leading-relaxed"></textarea>
					<div class="flex items-center gap-3">
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
							Record their answer
						}
						<span data-result class="font-mono text-xs text-muted-foreground"></span>
					</div>
				</form>
			</div>
		</details>
	</div>
}
